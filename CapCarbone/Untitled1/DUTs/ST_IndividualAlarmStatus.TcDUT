<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <DUT Name="ST_IndividualAlarmStatus" Id="{9e66db20-90c3-4e97-aec6-cc5a94df363a}">
    <Declaration><![CDATA[TYPE ST_IndividualAlarmStatus :
STRUCT
    sAlarmName          : STRING(100);  // e.g., "R1_Compressor_MotionTimedOut"
    dtAckTime           : DT;
    sAckUser            : STRING(50);
    sAckUserName        : STRING(100);
    dtActiveTime        : DT;
    dtClearTime         : DT;
    sDisplayPath        : STRING(255);
    sDisplayPathOrSource: STRING(255);
    bEnabled            : BOOL;
    nEventState         : UINT;
    dtEventTime         : DT;
    rEventValue         : REAL;
    bIsAcked            : BOOL;
    bIsActive           : BOOL;
    bIsClear            : BOOL;
    bIsShelved          : BOOL;
    sLabel              : STRING(100);
    sName               : STRING(100);
    nPriority           : UINT;
    rSetpointA          : REAL;
    sSource             : STRING(255);
    nState              : UINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>