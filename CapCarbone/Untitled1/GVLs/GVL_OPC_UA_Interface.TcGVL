<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <GVL Name="GVL_OPC_UA_Interface" Id="{23c8f46c-56cc-41ff-81b7-22aab65a4bb4}">
    <Declaration><![CDATA[VAR_GLOBAL
    // Simplified OPC UA interface - just the data we need
    
    // Alarm integration for Ignition
    g_AlarmArrayForOPC : ARRAY[1..20] OF ST_Alarm;  // Copy for OPC UA
    g_nActiveAlarmsOPC : UINT;                       // Active alarm count
    g_nUnackedAlarmsOPC : UINT;                      // Unacked alarm count
    
    // Alarm acknowledgment from Ignition  
    g_AlarmAckRequest : UINT := 0;                   // Alarm ID to acknowledge (0 = none)
    g_AlarmAckTrigger : BOOL := FALSE;               // Trigger acknowledgment
    
    // Simple connection status (derived from tag quality)
    g_bOpcUaConnected : BOOL := FALSE;               // TRUE if tags have good quality
    g_sConnectionStatus : STRING := 'Checking...';   // Simple status message
    
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>