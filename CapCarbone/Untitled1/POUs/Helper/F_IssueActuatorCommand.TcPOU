<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="F_IssueActuatorCommand" Id="{039ba84f-c472-4325-8fd5-bb06a032bcc0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_IssueActuatorCommand : INT
VAR_INPUT
    sDevice       : STRING(50);   // e.g. 'Chariot1', 'Motor3', ...
    bArg          : BOOL;         // see spec: direction or homing flag
    bHasPosition  : BOOL := FALSE;
    nPosition     : LREAL := 0;    // used when Motor & !bArg & position present
	fVelocity    : LREAL := 100.0;
END_VAR
VAR
    nlen       : INT;
    n         : INT;
    sPrefix   : STRING(50);
    i         : INT;
    sTmp      : STRING(64);
    sIndexStr : STRING(1);
	nUnderscorePos : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* ========================================================= *)
(* PARSING LOGIC: R<ID>_<Name> (e.g., 'R1_Chariot')         *)
(* ========================================================= *)
nLen := LEN(sDevice);
nUnderscorePos := FIND(sDevice, '_');

(* Safety Checks: Length must be sufficient and underscore must exist *)
(* We expect at least 'R1_A' (4 chars) and underscore cannot be at start *)
IF (nLen < 4) OR (nUnderscorePos < 3) THEN
    F_IssueActuatorCommand := -1; (* Error: Invalid Format *)
    RETURN;
END_IF;

(* 1. Extract the ID Number *)
(* Take string between 'R' (pos 1) and '_' *)
(* Start at 2, Length is (UnderscorePos - 2) *)
sIndexStr := MID(sDevice, nUnderscorePos - 2, 2); 
n := STRING_TO_INT(sIndexStr);

(* 2. Extract the Name (Prefix) *)
(* Take everything to the right of the underscore *)
sPrefix := RIGHT(sDevice, nLen - nUnderscorePos);

(* 3. Rebuild the Base String "R<n>_" for reconstruction later *)
sTmp := CONCAT('R', INT_TO_STRING(n));
sTmp := CONCAT(sTmp, '_');


(* ========================================================= *)
(* DEVICE HANDLING LOGIC (Unchanged)                        *)
(* ========================================================= *)

(* ===================== *)
(* Non-motor devices     *)
(* ===================== *)
IF (sPrefix = 'Chariot') OR (sPrefix = 'Compressor') OR (sPrefix = 'Sensor') OR
   (sPrefix = 'HeatExCoupola') OR (sPrefix = 'RegenCoupola') THEN

    sRequestedActuator := CONCAT(sTmp, sPrefix);   // Reconstructs "R1_Chariot"

    IF sPrefix = 'Chariot' THEN
        CASE n OF
            1: Tri1_Mot_Cmd.bCommand := bArg;
            2: Tri2_Mot_Cmd.bCommand := bArg;
            3: Tri3_Mot_Cmd.bCommand := bArg;
            4: Tri4_Mot_Cmd.bCommand := bArg;
        END_CASE

    ELSIF sPrefix = 'Compressor' THEN
        CASE n OF
            1: Cmp1_Mot_Cmd.bCommand := bArg;
            3: Cmp2_Mot_Cmd.bCommand := bArg;
            (* n=2,4 handled elsewhere if needed *)
        END_CASE

    ELSIF sPrefix = 'Sensor' THEN
        CASE n OF
            1: Piv1_Mot_Cmd.bCommand := bArg;
        END_CASE

    ELSIF sPrefix = 'HeatExCoupola' THEN
        CASE n OF
            3: Gui1_Mot_Cmd.bCommand := bArg;
        END_CASE

    ELSIF sPrefix = 'RegenCoupola' THEN
        CASE n OF
            3: Gui2_Mot_Cmd.bCommand := bArg;
        END_CASE
    END_IF;

    // <<< return handling for non-motor >>>
    // function returns the global Result
    F_IssueActuatorCommand := Result;
    RETURN;
END_IF


(* ===================== *)
(* Motor devices         *)
(* ===================== *)
IF sPrefix = 'Motor' THEN
    
    IF bArg THEN
        (* Homing *)
        sRequestedActuator := CONCAT(sTmp, 'Home');   // Becomes "R<n>_Home"
        CASE n OF
            1: Rail1_Mot_Cmd.bHoming := TRUE;
            2: Rail2_Mot_Cmd.bHoming := TRUE;
            3: Rail3_Mot_Cmd.bHoming := TRUE;
            4: Rail4_Mot_Cmd.bHoming := TRUE;
        END_CASE
    ELSE
        (* Normal move *)
        sRequestedActuator := CONCAT(sTmp, 'Motor');  // Becomes "R<n>_Motor"
        
        IF bHasPosition THEN
            CASE n OF
                1: 
                    Rail1_Mot_Cmd.nCommand := nPosition;
                    IF fVelocity > 0.0 THEN
                        Rail1_Mot_Cmd.fVelocity := fVelocity;
                    ELSE
                        Rail1_Mot_Cmd.fVelocity := Mot_LoadedVel;
                    END_IF;

                2: 
                    Rail2_Mot_Cmd.nCommand := nPosition;
                    IF fVelocity > 0.0 THEN
                        Rail2_Mot_Cmd.fVelocity := fVelocity;
                    ELSE
                        Rail2_Mot_Cmd.fVelocity := Mot_LoadedVel;
                    END_IF;

                3: 
                    Rail3_Mot_Cmd.nCommand := nPosition;
                    IF fVelocity > 0.0 THEN
                        Rail3_Mot_Cmd.fVelocity := fVelocity;
                    ELSE
                        Rail3_Mot_Cmd.fVelocity := Mot_LoadedVel;
                    END_IF;

                4: 
                    Rail4_Mot_Cmd.nCommand := nPosition;
                    IF fVelocity > 0.0 THEN
                        Rail4_Mot_Cmd.fVelocity := fVelocity;
                    ELSE
                        Rail4_Mot_Cmd.fVelocity := Mot_LoadedVel;
                    END_IF;
            END_CASE
        END_IF
    END_IF;

    // <<< return handling for motors >>>
    F_IssueActuatorCommand := Result; 
    RETURN;
END_IF

(* Unknown prefix / Fallthrough *)
F_IssueActuatorCommand := -3;]]></ST>
    </Implementation>
    <LineIds Name="F_IssueActuatorCommand">
      <LineId Id="460" Count="138" />
      <LineId Id="119" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>