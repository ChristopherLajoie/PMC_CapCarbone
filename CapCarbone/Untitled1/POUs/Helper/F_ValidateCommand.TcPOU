<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="F_ValidateCommand" Id="{78d555e6-fe7f-4ee5-8b39-a253fc7e4044}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_ValidateCommand : BOOL
VAR_INPUT
    sInput : STRING;
END_VAR
VAR_OUTPUT
    bIsValid : BOOL;
    nX : INT;
    sY : STRING;
END_VAR
VAR
    nUnderscorePos : INT;
    sNumber : STRING;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[bIsValid := FALSE;
nX := 0;
sY := '';

// Check if string starts with "R"
IF LEFT(sInput, 1) <> 'R' THEN
    RETURN;
END_IF;

// Find the underscore position
nUnderscorePos := FIND(sInput, '_');
IF nUnderscorePos = 0 THEN
    RETURN;
END_IF;

// Extract the digit (X) between "R" and "_"
sNumber := MID(sInput, 1, nUnderscorePos - 1);
nX := STRING_TO_INT(sNumber);
IF nX < 1 OR nX > 4 THEN
    RETURN;
END_IF;

// Extract the value part (Y) after "_"
sY := RIGHT(sInput, LEN(sInput) - nUnderscorePos);

// Check if Y is one of the allowed values
IF sY = 'Chariot' OR 
   sY = 'Compressor' OR 
   sY = 'Sensor' OR 
   sY = 'HeatExCoupola' OR 
   sY = 'RegenCoupola' OR
   sY = 'Home' OR 
   sY = 'Motor' THEN
    bIsValid := TRUE;
ELSE
    sY := '';  // Reset to empty if invalid
END_IF;

F_ValidateCommand := bIsValid;]]></ST>
    </Implementation>
    <LineIds Name="F_ValidateCommand">
      <LineId Id="1" Count="29" />
      <LineId Id="38" Count="0" />
      <LineId Id="31" Count="5" />
      <LineId Id="40" Count="0" />
      <LineId Id="39" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>