<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="FB_OpcUaAlarmReader" Id="{2a5d8a06-9c78-4353-bbb1-ee0806d8f663}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_OpcUaAlarmReader
VAR_INPUT
    bEnable         : BOOL := TRUE;    // Enable OPC UA reading
    sServerUrl      : STRING(255) := 'opc.tcp://localhost:62541'; // Ignition OPC UA server URL
    bConnect        : BOOL;            // Connect trigger
    bDisconnect     : BOOL;            // Disconnect trigger
	
	 // NEW: Security and Authentication settings
    sUsername       : STRING(100) := 'christopherlajoie';    // Username for authentication
    sPassword       : STRING(100) := 'password';    // Password for authentication
END_VAR

VAR_OUTPUT
    bConnected      : BOOL;            // Connection status
    bError          : BOOL;            // Error flag
    nErrorID        : UDINT;           // Error ID
    sErrorText      : STRING(255);     // Error description
	bBusy           : BOOL;            // Operation in progress
END_VAR

VAR
    // PLCopen OPC UA function blocks (correct names from the library)
    fbConnect       : UA_Connect;
    fbConnectStatus : UA_ConnectGetStatus;
    fbDisconnect    : UA_Disconnect;
    fbRead          : UA_Read;
    fbReadList      : UA_ReadList;
    fbNodeGetHandle : UA_NodeGetHandle;
    fbNodeGetHandleList : UA_NodeGetHandleList;
    fbNodeReleaseHandle : UA_NodeReleaseHandle;
    
    // Connection management
    ConnectionHdl   : DWORD;           // Connection handle (DWORD as per library)
    bConnectDone    : BOOL;
    bConnectBusy    : BOOL;
    bConnectError   : BOOL;
    nConnectErrorID : UDINT;
    
    // Node handles for alarm properties
    aNodeHandles    : ARRAY[1..50] OF DWORD;  // Node handles for reading
    aNodeIds        : ARRAY[1..50] OF ST_UANodeID; // Fixed: Changed from STRING to ST_UANodeID
    nNodeCount      : UINT := 0;
    
    // Read data arrays - Fixed: Different data types for different values
    aReadValuesBool : ARRAY[1..50] OF BOOL;    // Boolean values (active, acked states)
    aReadValuesUInt : ARRAY[1..50] OF UINT;    // Integer values (counts, priorities)
    aReadValuesLReal: ARRAY[1..50] OF LREAL;   // Real values (if needed)
    aReadQuality    : ARRAY[1..50] OF BOOL;    // Quality of read values
    nBytesRead      : ARRAY[1..50] OF UDINT;   // Bytes actually read
    
    // Data structures to store alarm information
    aGeneralAlarmStatus : ARRAY[1..20] OF ST_GeneralAlarmStatus; // One per alarm tag
    aIndividualAlarmStatus : ARRAY[1..20] OF ST_IndividualAlarmStatus;
    
    // State machine
    eState          : ENUM_OpcUaAlarmReaderState := ENUM_OpcUaAlarmReaderState.IDLE;
    bInitialized    : BOOL := FALSE;
    
    // Timers
    tmrRetry        : TON;
    tmrReadCycle    : TON;
    tmrTimeout      : TON;
    tRetryDelay     : TIME := T#5S;
    tReadCycle      : TIME := T#2S;    // Read every 2 seconds
    tOperationTimeout : TIME := T#10S;
    
    // Internal variables
    nCurrentIndex   : UINT;
    nReadCounter    : UINT;
    nErrorCounter   : UINT;
    bFirstRead      : BOOL := TRUE;
    bOperationBusy  : BOOL;        // Fixed: Added missing busy flag
    
    // Edge detection
    rtrigConnect    : R_TRIG;
    rtrigDisconnect : R_TRIG;
	
	// Security configuration
	stSessionConnectInfo : ST_UASessionConnectInfo;
	stUserIdentity       : ST_UAUserIdentityTokenType;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CheckConnectionStatus" Id="{b0cb22d8-cb50-419a-afc0-71657c0b728c}">
      <Declaration><![CDATA[METHOD CheckConnectionStatus : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbConnectStatus(
    Execute := TRUE,
    ConnectionHdl := ConnectionHdl,
    ServerState => ,
    Done => ,
    Busy => ,
    Error => bConnectError,
    ErrorID => nConnectErrorID
);

IF bConnectError THEN
    bConnected := FALSE;
    bError := TRUE;
    nErrorID := nConnectErrorID;
    sErrorText := 'Connection lost';
    eState := ENUM_OpcUaAlarmReaderState.ERROR_STATE;
END_IF

CheckConnectionStatus := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{ae666429-22a9-45b7-abf3-091cac74d78f}">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR
    i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Initialize node IDs if not done
IF NOT bInitialized AND bEnable THEN
    InitializeNodeIds();
    bInitialized := TRUE;
END_IF

// Handle edge triggers
rtrigConnect(CLK := bConnect);
rtrigDisconnect(CLK := bDisconnect);

// Handle timers
tmrRetry(IN := eState = ENUM_OpcUaAlarmReaderState.ERROR_STATE, PT := tRetryDelay);
tmrReadCycle(IN := eState = ENUM_OpcUaAlarmReaderState.CONNECTED, PT := tReadCycle);
tmrTimeout(IN := bOperationBusy, PT := tOperationTimeout);

bBusy := bOperationBusy;

// Timeout handling
IF tmrTimeout.Q THEN
    bError := TRUE;
    nErrorID := 16#8001; // Timeout error
    sErrorText := 'Operation timeout';
    eState := ENUM_OpcUaAlarmReaderState.ERROR_STATE;
    tmrTimeout(IN := FALSE);
END_IF

// Main state machine
CASE eState OF
    ENUM_OpcUaAlarmReaderState.IDLE:
        bOperationBusy := FALSE;
        IF rtrigConnect.Q AND bEnable THEN
            eState := ENUM_OpcUaAlarmReaderState.CONNECTING;
            bError := FALSE;
            nErrorID := 0;
            sErrorText := '';
            bOperationBusy := TRUE;
        END_IF
        
    ENUM_OpcUaAlarmReaderState.CONNECTING:
        ProcessConnection();
        
    ENUM_OpcUaAlarmReaderState.CONNECTED:
        // Check connection status periodically
        CheckConnectionStatus();
        
        // Start cyclic reading
        IF tmrReadCycle.Q OR bFirstRead THEN
            tmrReadCycle(IN := FALSE);
            eState := ENUM_OpcUaAlarmReaderState.GETTING_HANDLES;
            bFirstRead := FALSE;
        END_IF
        
        // Handle disconnect request
        IF rtrigDisconnect.Q THEN
            eState := ENUM_OpcUaAlarmReaderState.DISCONNECTING;
        END_IF
        
    ENUM_OpcUaAlarmReaderState.GETTING_HANDLES:
        GetNodeHandles();
        
    ENUM_OpcUaAlarmReaderState.READING_DATA:
        ReadAlarmData();
        
    ENUM_OpcUaAlarmReaderState.PROCESSING_DATA:
        ProcessReadData();
        
    ENUM_OpcUaAlarmReaderState.ERROR_STATE:
        bOperationBusy := FALSE;
        IF tmrRetry.Q THEN
            tmrRetry(IN := FALSE);
            eState := ENUM_OpcUaAlarmReaderState.IDLE;
            nErrorCounter := nErrorCounter + 1;
        END_IF
        
    ENUM_OpcUaAlarmReaderState.DISCONNECTING:
        ProcessDisconnection();
END_CASE

// Always call the function blocks
fbConnect();
fbConnectStatus();
fbDisconnect();
fbRead();
fbNodeGetHandle();

Execute := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetNodeHandles" Id="{c203bd4b-c80c-44b0-a152-ec62f7664c36}">
      <Declaration><![CDATA[METHOD GetNodeHandles : BOOL
VAR
    i : UINT;
    bAllHandlesOk : BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Get handles for all node IDs
FOR i := 1 TO nNodeCount DO
    fbNodeGetHandle(
        Execute := TRUE,
        ConnectionHdl := ConnectionHdl,
        NodeID := aNodeIds[i],  // Fixed: Now properly typed as ST_UANodeID
        NodeHdl => aNodeHandles[i],
        Done => ,
        Busy => ,
        Error => ,
        ErrorID => 
    );
    
    IF fbNodeGetHandle.Error THEN
        bAllHandlesOk := FALSE;
    END_IF
END_FOR

IF bAllHandlesOk THEN
    eState := ENUM_OpcUaAlarmReaderState.READING_DATA;
ELSE
    bError := TRUE;
    nErrorID := 16#8002;
    sErrorText := 'Failed to get node handles';
    eState := ENUM_OpcUaAlarmReaderState.ERROR_STATE;
END_IF

GetNodeHandles := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitializeNodeIds" Id="{6ccbf9bf-8e6f-4ee7-b3a6-97849f24d596}">
      <Declaration><![CDATA[METHOD InitializeNodeIds : BOOL
VAR
    i : UINT;
    sAlarmName : STRING(100);
    sNodeIdString : STRING(255);  // Temporary string for node ID
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[nNodeCount := 0;
sAlarmName := 'R1_Compressor_MotionTimedOut';

// Create ST_UANodeID structures with correct enumeration
// Per-Tag "General" alarm status (from the Alarms sub-component)
nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, 'Alarms', 'ActiveAckCount');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, 'Alarms', 'ActiveUnackCount');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, 'Alarms', 'HasActive');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, 'Alarms', 'HasUnacknowledged');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

// Individual alarm properties (component name = alarm name)
nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, sAlarmName, 'IsAcked');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, sAlarmName, 'IsActive');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, sAlarmName, 'IsClear');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, sAlarmName, 'Priority');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, sAlarmName, 'ActiveTime');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

// Example for additional alarms
sAlarmName := 'R2_Stepper_PowerUp_Failed';
nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, sAlarmName, 'IsActive');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

nNodeCount := nNodeCount + 1;
sNodeIdString := F_GenerateAlarmNodeId(sAlarmName, sAlarmName, 'IsAcked');
aNodeIds[nNodeCount].sIdentifier := sNodeIdString;
aNodeIds[nNodeCount].eIdentifierType := E_UAIdentifierType.eUAIdentifierType_String;
aNodeIds[nNodeCount].nNamespaceIndex := 2;

// TODO: Add all your other alarms by repeating this pattern
// sAlarmName := 'R3_Compressor_UnknownState';
// aNodeIds[nNodeCount] := F_GenerateAlarmNodeId(sAlarmName, sAlarmName, 'IsActive');

InitializeNodeIds := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitializeSecurity" Id="{c7a0c753-bd29-4dda-93a3-dfd3dfbd9bda}">
      <Declaration><![CDATA[METHOD InitializeSecurity : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Configure User Identity
stUserIdentity.eUserIdentTokenType := E_UAUserIdentityTokenType.eUAUITT_UserName;
stUserIdentity.sTokenParam1 := sUsername;  // Username
stUserIdentity.sTokenParam2 := sPassword;  // Password

// Configure Session Connect Info with CORRECT enum values
stSessionConnectInfo.stUserIdentTokenType := stUserIdentity;
stSessionConnectInfo.eSecurityMode := eUASecurityMsgMode_BestAvailable;  // CORRECTED: Sign_Encrypt with underscore
//stSessionConnectInfo.eSecurityMode := E_UASecurityMsgMode.eUASecurityMsgMode_None;
stSessionConnectInfo.eSecurityPolicyUri := E_UASecurityPolicy.eUASecurityPolicy_Basic256Sha256;
//stSessionConnectInfo.eSecurityPolicyUri := eUASecurityPolicy_None;
stSessionConnectInfo.sApplicationName := 'TwinCAT_AlarmReader';
stSessionConnectInfo.tSessionTimeout := T#60S;
stSessionConnectInfo.tConnectTimeout := T#10S;

InitializeSecurity := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessConnection" Id="{9b5dcda2-55cf-4898-a6ee-67c95c7b0231}">
      <Declaration><![CDATA[METHOD ProcessConnection : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[InitializeSecurity();

// Connect with security settings
fbConnect(
    Execute := TRUE,
    ServerUrl := sServerUrl,
    SessionConnectInfo := stSessionConnectInfo,  // NOW using security settings
    ConnectionHdl => ConnectionHdl,
    Done => bConnectDone,
    Busy => bConnectBusy,
    Error => bConnectError,
    ErrorID => nConnectErrorID
);

IF bConnectError THEN
    bError := TRUE;
    nErrorID := nConnectErrorID;
    sErrorText := 'Connection failed - Check security settings and credentials';
    eState := ENUM_OpcUaAlarmReaderState.ERROR_STATE;
    
ELSIF bConnectDone THEN
    bConnected := TRUE;
    eState := ENUM_OpcUaAlarmReaderState.CONNECTED;
    bOperationBusy := FALSE;
END_IF

ProcessConnection := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessDisconnection" Id="{199a797c-d58b-42ed-866f-690855e60f79}">
      <Declaration><![CDATA[METHOD ProcessDisconnection : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbDisconnect(
    Execute:= TRUE,
    ConnectionHdl := ConnectionHdl,
    Done => ,
    Busy => ,
    Error => ,
    ErrorID => 
);

IF fbDisconnect.Done THEN
    bConnected := FALSE;
    ConnectionHdl := 0;
    eState := ENUM_OpcUaAlarmReaderState.IDLE;
    bDisconnect := FALSE;
    bOperationBusy := FALSE;
    
    // Release all node handles
    FOR nCurrentIndex := 1 TO nNodeCount DO
        aNodeHandles[nCurrentIndex] := 0;
    END_FOR
    
ELSIF fbDisconnect.Error THEN
    // Force disconnection even if error
    bConnected := FALSE;
    ConnectionHdl := 0;
    eState := ENUM_OpcUaAlarmReaderState.IDLE;
    bDisconnect := FALSE;
    bOperationBusy := FALSE;
END_IF

ProcessDisconnection := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReadData" Id="{f171cd0d-723e-40d7-af71-7d88e2f09690}">
      <Declaration><![CDATA[METHOD ProcessReadData : BOOL
VAR
    i : UINT;
    nAlarmIndex : UINT := 1; // Which alarm we're processing
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Fixed: Process the read data with correct type conversions
// Example: Update per-tag "general" alarm status for R1_Compressor_MotionTimedOut
aGeneralAlarmStatus[nAlarmIndex].sForAlarmTag := 'R1_Compressor_MotionTimedOut';

// Fixed: Use appropriate arrays based on data type expected
IF aReadQuality[1] THEN
    aGeneralAlarmStatus[nAlarmIndex].nActiveAckCount := aReadValuesUInt[1];  // Fixed: Use UINT array
END_IF

IF aReadQuality[2] THEN
    aGeneralAlarmStatus[nAlarmIndex].nActiveUnackCount := aReadValuesUInt[2];  // Fixed: Use UINT array
END_IF

IF aReadQuality[3] THEN
    aGeneralAlarmStatus[nAlarmIndex].bHasActive := aReadValuesBool[3];  // Fixed: Use BOOL array
END_IF

IF aReadQuality[4] THEN
    aGeneralAlarmStatus[nAlarmIndex].bHasUnacknowledged := aReadValuesBool[4];  // Fixed: Use BOOL array
END_IF

// Update individual alarm status for the same alarm
aIndividualAlarmStatus[nAlarmIndex].sAlarmName := 'R1_Compressor_MotionTimedOut';

IF aReadQuality[5] THEN
    aIndividualAlarmStatus[nAlarmIndex].bIsAcked := aReadValuesBool[5];  // Fixed: Use BOOL array
END_IF

IF aReadQuality[6] THEN
    aIndividualAlarmStatus[nAlarmIndex].bIsActive := aReadValuesBool[6];  // Fixed: Use BOOL array
END_IF

IF aReadQuality[7] THEN
    aIndividualAlarmStatus[nAlarmIndex].bIsClear := aReadValuesBool[7];  // Fixed: Use BOOL array
END_IF

IF aReadQuality[8] THEN
    aIndividualAlarmStatus[nAlarmIndex].nPriority := aReadValuesUInt[8];  // Use UINT array for priority
END_IF

// TODO: Process data for other alarms (nAlarmIndex = 2, 3, etc.)

// Increment read counter
nReadCounter := nReadCounter + 1;

// Return to connected state for next cycle
eState := ENUM_OpcUaAlarmReaderState.CONNECTED;

ProcessReadData := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadAlarmData" Id="{a72ed9d5-23ef-4fac-9a8d-a1818162985b}">
      <Declaration><![CDATA[METHOD ReadAlarmData : BOOL
VAR
    i : UINT;
    pDataPtr : POINTER TO BYTE;
    nDataSize : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Fixed: Read different data types appropriately
IF nNodeCount > 0 THEN
    // Determine the correct data pointer and size based on expected data type
    // For this example, assume first few are UINT (counts), then BOOL (states)
    IF nCurrentIndex <= 2 THEN  // ActiveAckCount, ActiveUnackCount
        pDataPtr := ADR(aReadValuesUInt[nCurrentIndex]);
        nDataSize := SIZEOF(aReadValuesUInt[nCurrentIndex]);
    ELSE  // Boolean values like HasActive, IsAcked, etc.
        pDataPtr := ADR(aReadValuesBool[nCurrentIndex]);
        nDataSize := SIZEOF(aReadValuesBool[nCurrentIndex]);
    END_IF;
    
    fbRead(
        Execute := TRUE,
        ConnectionHdl := ConnectionHdl,
        NodeHdl := aNodeHandles[nCurrentIndex + 1],  // +1 because array starts at 1
        pVariable := pDataPtr,
        cbData := nDataSize,
		cbData_R => nBytesRead[nCurrentIndex + 1],
        Done => ,
        Busy => ,
        Error => ,
        ErrorID => 
    );
    
    IF fbRead.Done THEN
        aReadQuality[nCurrentIndex + 1] := NOT fbRead.Error;
        nCurrentIndex := nCurrentIndex + 1;
        
        // If we've read all nodes, process the data
        IF nCurrentIndex >= nNodeCount THEN
            nCurrentIndex := 0;  // Reset for next cycle
            eState := ENUM_OpcUaAlarmReaderState.PROCESSING_DATA;
        END_IF
        
    ELSIF fbRead.Error THEN
        bError := TRUE;
        nErrorID := fbRead.ErrorID;
        sErrorText := 'Read operation failed';
        eState := ENUM_OpcUaAlarmReaderState.ERROR_STATE;
    END_IF
END_IF

ReadAlarmData := TRUE;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_OpcUaAlarmReader">
      <LineId Id="1" Count="0" />
    </LineIds>
