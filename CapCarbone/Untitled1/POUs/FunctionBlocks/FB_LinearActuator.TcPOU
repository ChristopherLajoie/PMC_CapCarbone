<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="FB_LinearActuator" Id="{7b9c3bff-54cb-4df9-8ad3-e1094e9996e8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LinearActuator
VAR
    eState : ENUM_LinearActuatorState := LAS_LinearActuator_Uninitialized;
    tTimeout : TIME := T#10S;
    bError : BOOL;
    sErrorMsg : STRING(80);
    pActuator : POINTER TO ST_LinearActuator;
	
	bproxOutRisingEdge : BOOL := TRUE;  
	bProxInRisingEdge : BOOL := TRUE;   
	r_trig_proxOut : R_TRIG;            
	f_trig_proxOut : F_TRIG;            
	r_trig_proxIn : R_TRIG;             
	f_trig_proxIn : F_TRIG;             
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cancel" Id="{fb95bc7a-c6f6-46a4-ad31-adc69398fdb2}">
      <Declaration><![CDATA[METHOD Cancel : INT
VAR
    bValidPosition : BOOL := FALSE;
	pAlarmCondition : POINTER TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ============================================================================
// 1. IMMEDIATE SAFETY - Turn off all outputs first
// ============================================================================
pActuator^.bFwdDO^ := FALSE;
pActuator^.bBckwDO^ := FALSE;
pActuator^.bInProgress := FALSE;

// Stop the timeout timer
pActuator^.tmrTimeout(IN := FALSE);

// ============================================================================
// 2. DETERMINE CURRENT POSITION - Read proximity sensors
// ============================================================================
// Update edge detection triggers
r_trig_proxIn(CLK := pActuator^.bProxIn^);
f_trig_proxIn(CLK := pActuator^.bProxIn^);
r_trig_proxOut(CLK := pActuator^.bProxOut^);
f_trig_proxOut(CLK := pActuator^.bProxOut^);

// Check for retracted position
IF (bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^) THEN
    IF NOT ((bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^)) THEN
        // Retracted position - only In sensor active
        eState := LAS_LinearActuator_Retracted;
        bValidPosition := TRUE;
    END_IF
END_IF

// Check for extended position  
IF (bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^) THEN
    IF NOT ((bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^)) THEN
        // Extended position - only Out sensor active
        eState := LAS_LinearActuator_Extended;
        bValidPosition := TRUE;
    END_IF
END_IF

// ============================================================================
// 3. HANDLE INVALID/UNKNOWN POSITIONS
// ============================================================================
IF NOT bValidPosition THEN
    // Both sensors active, neither active, or sensor error
    eState := LAS_LinearActuator_Unknown;
    Cancel := -1;
	
	pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
		
	IF pAlarmCondition <> 0 THEN
		pAlarmCondition^ := TRUE;
	END_IF
	
    RETURN;
END_IF

bError := FALSE;
Cancel := 1; ]]></ST>
      </Implementation>
    </Method>
    <Method Name="CanReset" Id="{e451c082-6390-4897-b2c0-f7f1baa90012}">
      <Declaration><![CDATA[METHOD CanReset : BOOL
VAR
    bAllAlarmsAcked : BOOL := TRUE;
    sActuatorName : STRING(50);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState <> LAS_LinearActuator_Error THEN
    CanReset := TRUE;
    RETURN;
END_IF

CanReset := F_CheckLinearActuatorAlarmsAcked(pActuator^.sName);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Extend" Id="{afb44406-33a7-4c96-9c8b-3094883b11ba}">
      <Declaration><![CDATA[METHOD Extend : INT
VAR
	bProxOutDetected : BOOL;
	pAlarmCondition : POINTER TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Extend := 0;

r_trig_proxOut(CLK := pActuator^.bProxOut^);
f_trig_proxOut(CLK := pActuator^.bProxOut^);
bProxOutDetected := (bProxOutRisingEdge AND r_trig_proxOut.Q) OR (NOT bProxOutRisingEdge AND f_trig_proxOut.Q);

pActuator^.tmrTimeout(IN := pActuator^.bInProgress, PT := T#10S);
CASE eState OF
    LAS_LinearActuator_Retracted:
		pActuator^.bFwdDO^ := TRUE;
		pActuator^.bBckwDO^ := FALSE;
		pActuator^.bInProgress := FALSE; 
		
        IF NOT ((bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^)) THEN
            eState := LAS_LinearActuator_Extending;
            pActuator^.bInProgress := TRUE; 
        END_IF

    LAS_LinearActuator_Extending:
        IF (bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^) THEN
            eState := LAS_LinearActuator_Extended;
            pActuator^.bFwdDO^ := FALSE;
            pActuator^.bBckwDO^ := FALSE;
			pActuator^.bInProgress := FALSE; 
		END_IF
		
        IF pActuator^.tmrTimeout.Q THEN
            eState := LAS_LinearActuator_Error;
            bError := TRUE;
			
			pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'MotionTimedOut');
			
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
			
			pActuator^.bInProgress := FALSE; 
			pActuator^.bFwdDO^ := FALSE;
        END_IF

    LAS_LinearActuator_Extended:
        Extend := 1;

    LAS_LinearActuator_Error:
		Extend := -1;
		
	LAS_LinearActuator_Unknown:
		Extend := -1;
		
		pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
			
		IF pAlarmCondition <> 0 THEN
			pAlarmCondition^ := TRUE;
		END_IF

    ELSE
        // default catch-all
END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{70258f52-1024-4f1a-abb0-a262de844735}">
      <Declaration><![CDATA[METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
	Actuator : POINTER TO ST_LinearActuator;  
END_VAR

VAR
	pAlarmCondition : POINTER TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pActuator := Actuator;
bProxOutRisingEdge := ProxOutRisingEdge;
bProxInRisingEdge := ProxInRisingEdge;

r_trig_proxOut(CLK := pActuator^.bProxOut^);
f_trig_proxOut(CLK := pActuator^.bProxOut^);
r_trig_proxIn(CLK := pActuator^.bProxIn^);
f_trig_proxIn(CLK := pActuator^.bProxIn^);

// Check positions according to edge detection settings
IF (bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^) THEN
    IF NOT ((bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^)) THEN
        eState := LAS_LinearActuator_Retracted;
    ELSE
        eState := LAS_LinearActuator_Unknown;
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
			
		IF pAlarmCondition <> 0 THEN
			pAlarmCondition^ := TRUE;
		END_IF
		
    END_IF
ELSIF (bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^) THEN
    IF NOT ((bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^)) THEN
        eState := LAS_LinearActuator_Extended;
    ELSE
        eState := LAS_LinearActuator_Unknown;
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
			
		IF pAlarmCondition <> 0 THEN
			pAlarmCondition^ := TRUE;
		END_IF
		
    END_IF
ELSE
    eState := LAS_LinearActuator_Unknown;
    pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
			
	IF pAlarmCondition <> 0 THEN
		pAlarmCondition^ := TRUE;
	END_IF
END_IF

FB_Init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home" Id="{f928c3cc-e926-4d68-aa06-e49d712546af}">
      <Declaration><![CDATA[METHOD Home : INT
VAR
	bProxInDetected : BOOL;  
	pAlarmCondition : POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Home := 0;

r_trig_proxIn(CLK := pActuator^.bProxIn^);
f_trig_proxIn(CLK := pActuator^.bProxIn^);
bProxInDetected := (bProxInRisingEdge AND r_trig_proxIn.Q) OR (NOT bProxInRisingEdge AND f_trig_proxIn.Q);

pActuator^.tmrTimeout(IN := pActuator^.bInProgress, PT := T#10S);

CASE eState OF
    LAS_LinearActuator_Extended:
		pActuator^.bFwdDO^ := FALSE;
		pActuator^.bBckwDO^ := TRUE;
		pActuator^.bInProgress := FALSE; 
		
        IF NOT ((bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^)) THEN
            eState := LAS_LinearActuator_Retracting;
            pActuator^.bInProgress := TRUE; 
        END_IF

    LAS_LinearActuator_Retracting:
        IF (bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^) THEN
            eState := LAS_LinearActuator_Retracted;
            pActuator^.bFwdDO^ := FALSE;
            pActuator^.bBckwDO^ := FALSE;
			pActuator^.bInProgress := FALSE; 
        END_IF
		
        IF pActuator^.tmrTimeout.Q THEN
            eState := LAS_LinearActuator_Error;
            bError := TRUE;
			pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'MotionTimedOut');
			
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
			
			pActuator^.bInProgress := FALSE; 
			pActuator^.bBckwDO^ := FALSE;
        END_IF

    LAS_LinearActuator_Retracted:
        Home := 1;

    LAS_LinearActuator_Error:
		Home := -1;
	
	LAS_LinearActuator_Unknown:
		Home := -1;
		
		pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
		
		IF pAlarmCondition <> 0 THEN
			pAlarmCondition^ := TRUE;
		END_IF
    
    ELSE
        // default catch-all
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{ecdda1b9-dec3-446e-af49-02346c123f36}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR
    i : UINT;
    sActuatorName : STRING(50);
	pAlarmCondition : POINTER TO BOOL;
END_VAR
VAR_OUTPUT
    State : SINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState = LAS_LinearActuator_Error AND Canreset() THEN
    
    // Use the existing sName from the actuator structure
    sActuatorName := pActuator^.sName;
    
    IF (bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^) THEN    
        eState := LAS_LinearActuator_Retracted;
        bError := FALSE;
        State := 0;
        
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
        IF pAlarmCondition <> 0 THEN
            pAlarmCondition^ := FALSE;
        END_IF
        
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'MotionTimedOut');
        IF pAlarmCondition <> 0 THEN
            pAlarmCondition^ := FALSE;
        END_IF
        
    ELSIF (bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^) THEN
        eState := LAS_LinearActuator_Extended;
        bError := FALSE;
        State := 1;
        
         // CLEAR ALARM CONDITIONS dynamically - position is now known
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
        IF pAlarmCondition <> 0 THEN
            pAlarmCondition^ := FALSE;
        END_IF
        
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'MotionTimedOut');
        IF pAlarmCondition <> 0 THEN
            pAlarmCondition^ := FALSE;
        END_IF
        
    ELSE
        eState := LAS_LinearActuator_Unknown;
        State := -1;
		
		pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
			
		IF pAlarmCondition <> 0 THEN
			pAlarmCondition^ := TRUE;
		END_IF
    END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
