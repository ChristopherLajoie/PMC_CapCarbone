<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="FB_LinearActuator" Id="{7b9c3bff-54cb-4df9-8ad3-e1094e9996e8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LinearActuator
VAR
    eState : ENUM_LinearActuatorState := LAS_LinearActuator_Uninitialized;
    tTimeout : TIME := T#10S;
    bError : BOOL;
    sErrorMsg : STRING(80);
    pActuator : POINTER TO ST_LinearActuator;
	
	// Edge selection flags - one for each sensor
    bProxInRisingEdge : BOOL := TRUE;   
    bProxOutRisingEdge : BOOL := TRUE;  
    bProx2RisingEdge : BOOL := TRUE;    // NEW: Edge selection for Prox2
    bProx3RisingEdge : BOOL := TRUE;    // NEW: Edge selection for Prox3
    
    // Edge detection triggers
    r_trig_proxIn : R_TRIG;             
    f_trig_proxIn : F_TRIG;            
    r_trig_proxOut : R_TRIG;            
    f_trig_proxOut : F_TRIG;            
    r_trig_prox2 : R_TRIG;
    f_trig_prox2 : F_TRIG;
    r_trig_prox3 : R_TRIG;
    f_trig_prox3 : F_TRIG;
    
    // Helper variables
    bHas4Sensors : BOOL;  // TRUE if actuator has 4 sensors
    bIs2Sensor : BOOL;    // TRUE if actuator has only 2 sensors
    
    // Edge detection results (updated once per scan)
    bProxInDetected : BOOL;
    bProxOutDetected : BOOL;
    bProx2Detected : BOOL;
    bProx3Detected : BOOL;
	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cancel" Id="{fb95bc7a-c6f6-46a4-ad31-adc69398fdb2}">
      <Declaration><![CDATA[METHOD Cancel : INT
VAR
    bValidPosition : BOOL := FALSE;
	pAlarmCondition : POINTER TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Immediate safety - Stop all movement and set to safe state
SetStoppedState();

// Stop the timeout timer
pActuator^.tmrTimeout(IN := FALSE);

// Determine current position - check all possible positions
IF (bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^) THEN
    eState := LAS_LinearActuator_Retracted;
    bValidPosition := TRUE;
ELSIF (bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^) THEN
    eState := LAS_LinearActuator_Extended;
    bValidPosition := TRUE;
ELSIF bHas4Sensors THEN
    IF (bProxInRisingEdge AND pActuator^.bProx2^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProx2^) THEN
        eState := LAS_LinearActuator_AtProx2;
        bValidPosition := TRUE;
    ELSIF (bProxOutRisingEdge AND pActuator^.bProx3^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProx3^) THEN
        eState := LAS_LinearActuator_AtProx3;
        bValidPosition := TRUE;
    END_IF
END_IF

// Handle invalid/unknown positions
IF NOT bValidPosition THEN
    eState := LAS_LinearActuator_Unknown;
    Cancel := -1;
    
    pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
    IF pAlarmCondition <> 0 THEN
        pAlarmCondition^ := TRUE;
    END_IF
    
    RETURN;
END_IF

bError := FALSE;
Cancel := 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CanReset" Id="{e451c082-6390-4897-b2c0-f7f1baa90012}">
      <Declaration><![CDATA[METHOD CanReset : BOOL
VAR
    bAllAlarmsAcked : BOOL := TRUE;
    sActuatorName : STRING(50);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState <> LAS_LinearActuator_Error THEN
    CanReset := TRUE;
    RETURN;
END_IF

//CanReset := F_CheckLinearActuatorAlarmsAcked(pActuator^.sName);
CanReset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Extend" Id="{afb44406-33a7-4c96-9c8b-3094883b11ba}">
      <Declaration><![CDATA[METHOD Extend : INT
VAR
    bProxOutDetected : BOOL;
    bProx2Detected : BOOL;
    bProx3Detected : BOOL;
    pAlarmCondition : POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Extend := 0;

// Update edge detection ONCE at start of method
UpdateEdgeDetection();

pActuator^.tmrTimeout(IN := pActuator^.bInProgress, PT := T#10S);

CASE eState OF
    LAS_LinearActuator_Retracted, LAS_LinearActuator_AtProx2, LAS_LinearActuator_AtProx3:
        // Start extension from any position
        SetForwardMovement();
        eState := LAS_LinearActuator_Extending;

    LAS_LinearActuator_Extending:
        // Check for position detection during movement (4-sensor only)
        IF bHas4Sensors THEN
            IF bProx2Detected THEN
                eState := LAS_LinearActuator_AtProx2;
                // Keep fast speed when at Prox2
            ELSIF bProx3Detected THEN
                eState := LAS_LinearActuator_AtProx3;
                // Slow down when reaching Prox3
                IF pActuator^.bSpeedControlDO <> 0 THEN
                    pActuator^.bSpeedControlDO^ := FALSE;  // Slow speed
                END_IF
            END_IF
        END_IF
        
        // Check if fully extended
        IF bProxOutDetected THEN
            eState := LAS_LinearActuator_Extended;
            SetStoppedState(); // Different logic for 2-sensor vs 4-sensor
            Extend := 1; // Success
        END_IF
        
        // Check for timeout
        IF pActuator^.tmrTimeout.Q THEN
            eState := LAS_LinearActuator_Error;
            bError := TRUE;
            
            pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'MotionTimedOut');
            IF pAlarmCondition <> 0 THEN
                pAlarmCondition^ := TRUE;
            END_IF
            
            SetStoppedState(); // Safe stop
            Extend := -1;
        END_IF

    LAS_LinearActuator_Extended:
        Extend := 1; // Already extended

    LAS_LinearActuator_Error:
        Extend := -1;
        
    LAS_LinearActuator_Unknown:
        Extend := -1;
        
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
        IF pAlarmCondition <> 0 THEN
            pAlarmCondition^ := TRUE;
        END_IF

    ELSE
        // default catch-all
        Extend := -1;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{70258f52-1024-4f1a-abb0-a262de844735}">
      <Declaration><![CDATA[METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL;
    bInCopyCode: BOOL;   
    Actuator : POINTER TO ST_LinearActuator;  
END_VAR
VAR
    pAlarmCondition : POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pActuator := Actuator;

// Detect actuator type
bHas4Sensors := (pActuator^.bProx2 <> 0) AND (pActuator^.bProx3 <> 0);
bIs2Sensor := NOT bHas4Sensors;

// Initialize speed control for 4-sensor actuators only
IF bHas4Sensors AND pActuator^.bSpeedControlDO <> 0 THEN
    pActuator^.bSpeedControlDO^ := TRUE;  // High = fast speed
END_IF

// Initialize edge detection
UpdateEdgeDetection();

// Determine initial position - check all possible positions
IF pActuator^.bProxIn^ THEN
    eState := LAS_LinearActuator_Retracted;
ELSIF pActuator^.bProxOut^ THEN
    eState := LAS_LinearActuator_Extended;
ELSIF bHas4Sensors THEN
    IF pActuator^.bProx2^ THEN
        eState := LAS_LinearActuator_AtProx2;
    ELSIF pActuator^.bProx3^ THEN
        eState := LAS_LinearActuator_AtProx3;
    ELSE
        eState := LAS_LinearActuator_Unknown;
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
        IF pAlarmCondition <> 0 THEN
            pAlarmCondition^ := TRUE;
        END_IF
    END_IF
ELSE
    eState := LAS_LinearActuator_Unknown;
    pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
    IF pAlarmCondition <> 0 THEN
        pAlarmCondition^ := TRUE;
    END_IF
END_IF

// Set initial output state based on actuator type
SetStoppedState();

FB_Init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home" Id="{f928c3cc-e926-4d68-aa06-e49d712546af}">
      <Declaration><![CDATA[METHOD Home : INT
VAR
    bProxInDetected : BOOL;
    bProx2Detected : BOOL;
    bProx3Detected : BOOL;
    pAlarmCondition : POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Home := 0;

// Update edge detection ONCE at start of method
UpdateEdgeDetection();

pActuator^.tmrTimeout(IN := pActuator^.bInProgress, PT := T#10S);

CASE eState OF
    LAS_LinearActuator_Extended, LAS_LinearActuator_AtProx3, LAS_LinearActuator_AtProx2:
        // Start retraction from any position
        SetBackwardMovement();
        eState := LAS_LinearActuator_Retracting;

    LAS_LinearActuator_Retracting:
        // Check for position detection during movement (4-sensor only)
        IF bHas4Sensors THEN
            IF bProx3Detected THEN
                eState := LAS_LinearActuator_AtProx3;
                // Keep fast speed when at Prox3
            ELSIF bProx2Detected THEN
                eState := LAS_LinearActuator_AtProx2;
                // Slow down when reaching Prox2
                IF pActuator^.bSpeedControlDO <> 0 THEN
                    pActuator^.bSpeedControlDO^ := FALSE;  // Slow speed
                END_IF
            END_IF
        END_IF
        
        // Check if fully retracted
        IF bProxInDetected THEN
            eState := LAS_LinearActuator_Retracted;
            SetStoppedState(); // Different logic for 2-sensor vs 4-sensor
            Home := 1; // Success
        END_IF
        
        // Check for timeout
        IF pActuator^.tmrTimeout.Q THEN
            eState := LAS_LinearActuator_Error;
            bError := TRUE;
            
            pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'MotionTimedOut');
            IF pAlarmCondition <> 0 THEN
                pAlarmCondition^ := TRUE;
            END_IF
            
            SetStoppedState(); // Safe stop
            Home := -1;
        END_IF

    LAS_LinearActuator_Retracted:
        Home := 1; // Already retracted

    LAS_LinearActuator_Error:
        Home := -1;
    
    LAS_LinearActuator_Unknown:
        Home := -1;
        
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
        IF pAlarmCondition <> 0 THEN
            pAlarmCondition^ := TRUE;
        END_IF
    
    ELSE
        // default catch-all
        Home := -1;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{ecdda1b9-dec3-446e-af49-02346c123f36}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR
    i : UINT;
    sActuatorName : STRING(50);
	pAlarmCondition : POINTER TO BOOL;
END_VAR
VAR_OUTPUT
    State : SINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState = LAS_LinearActuator_Error AND CanReset() THEN
    
    sActuatorName := pActuator^.sName;
    
    // Reset speed to fast
    IF pActuator^.bSpeedControlDO <> 0 THEN
        pActuator^.bSpeedControlDO^ := TRUE;  // Fast speed
    END_IF
    
    // Determine position after reset
    IF (bProxInRisingEdge AND pActuator^.bProxIn^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProxIn^) THEN    
        eState := LAS_LinearActuator_Retracted;
        bError := FALSE;
        State := 0;
    ELSIF bHas4Sensors AND ((bProxInRisingEdge AND pActuator^.bProx2^) OR (NOT bProxInRisingEdge AND NOT pActuator^.bProx2^)) THEN
        eState := LAS_LinearActuator_Retracted;
        bError := FALSE;
        State := 0;
    ELSIF (bProxOutRisingEdge AND pActuator^.bProxOut^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProxOut^) THEN
        eState := LAS_LinearActuator_Extended;
        bError := FALSE;
        State := 1;
    ELSIF bHas4Sensors AND ((bProxOutRisingEdge AND pActuator^.bProx3^) OR (NOT bProxOutRisingEdge AND NOT pActuator^.bProx3^)) THEN
        eState := LAS_LinearActuator_Extended;
        bError := FALSE;
        State := 1;
    ELSE
        eState := LAS_LinearActuator_Unknown;
        State := -1;
        
        pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
        IF pAlarmCondition <> 0 THEN
            pAlarmCondition^ := TRUE;
        END_IF
        RETURN;
    END_IF
    
    // Clear alarm conditions if position is now known
    pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'UnknownState');
    IF pAlarmCondition <> 0 THEN
        pAlarmCondition^ := FALSE;
    END_IF
    
    pAlarmCondition := F_GetLinearActuatorAlarmCondition(pActuator^.sName, 'MotionTimedOut');
    IF pAlarmCondition <> 0 THEN
        pAlarmCondition^ := FALSE;
    END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetBackwardMovement" Id="{2c497243-ee6e-4e97-99a2-fe8b03e246e5}">
      <Declaration><![CDATA[METHOD SetBackwardMovement : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Both types: Forward FALSE, Backward TRUE
pActuator^.bFwdDO^ := FALSE;
pActuator^.bBckwDO^ := TRUE;
pActuator^.bInProgress := TRUE;

// Set speed for 4-sensor actuators
IF bHas4Sensors AND pActuator^.bSpeedControlDO <> 0 THEN
    pActuator^.bSpeedControlDO^ := TRUE;  // Fast speed initially
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetForwardMovement" Id="{75e1c4ab-755e-4c46-b900-5237b95878fd}">
      <Declaration><![CDATA[METHOD SetForwardMovement : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pActuator^.bFwdDO^ := TRUE;
pActuator^.bBckwDO^ := FALSE;
pActuator^.bInProgress := TRUE;

// Set speed for 4-sensor actuators
IF bHas4Sensors AND pActuator^.bSpeedControlDO <> 0 THEN
    pActuator^.bSpeedControlDO^ := TRUE;  // Fast speed initially
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetStoppedState" Id="{62143208-bdb9-4a5a-872a-8b7d09b4a9aa}">
      <Declaration><![CDATA[METHOD SetStoppedState : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bIs2Sensor THEN
    pActuator^.bFwdDO^ := TRUE;
    pActuator^.bBckwDO^ := TRUE;
ELSE
    pActuator^.bFwdDO^ := FALSE;
    pActuator^.bBckwDO^ := FALSE;
END_IF
pActuator^.bInProgress := FALSE;

// Reset speed to fast for 4-sensor actuators
IF bHas4Sensors AND pActuator^.bSpeedControlDO <> 0 THEN
    pActuator^.bSpeedControlDO^ := TRUE;  // Fast speed
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateEdgeDetection" Id="{6e178de4-6a01-4e7a-9cb7-df152934fa89}">
      <Declaration><![CDATA[METHOD UpdateEdgeDetection : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Update all edge detection triggers ONCE per scan cycle
r_trig_proxIn(CLK := pActuator^.bProxIn^);
f_trig_proxIn(CLK := pActuator^.bProxIn^);
r_trig_proxOut(CLK := pActuator^.bProxOut^);
f_trig_proxOut(CLK := pActuator^.bProxOut^);

// Calculate edge detection results using individual flags
bProxInDetected := (bProxInRisingEdge AND r_trig_proxIn.Q) OR (NOT bProxInRisingEdge AND f_trig_proxIn.Q);
bProxOutDetected := (bProxOutRisingEdge AND r_trig_proxOut.Q) OR (NOT bProxOutRisingEdge AND f_trig_proxOut.Q);

IF bHas4Sensors THEN
    r_trig_prox2(CLK := pActuator^.bProx2^);
    f_trig_prox2(CLK := pActuator^.bProx2^);
    r_trig_prox3(CLK := pActuator^.bProx3^);
    f_trig_prox3(CLK := pActuator^.bProx3^);
    
    // Use individual edge selection flags for each sensor
    bProx2Detected := (bProx2RisingEdge AND r_trig_prox2.Q) OR (NOT bProx2RisingEdge AND f_trig_prox2.Q);
    bProx3Detected := (bProx3RisingEdge AND r_trig_prox3.Q) OR (NOT bProx3RisingEdge AND f_trig_prox3.Q);
ELSE
    bProx2Detected := FALSE;
    bProx3Detected := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
