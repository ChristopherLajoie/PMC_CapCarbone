<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="FB_StepperMotor" Id="{bbe3d249-0f45-4d4f-9e26-26a436162bb5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StepperMotor
VAR_INPUT
	nRail 	   : SINT := 0;
END_VAR
VAR
	pAxis : POINTER TO AXIS_REF;
	fRead : MC_ReadActualPosition;
    fbPower    : MC_Power;
    fbstop     : MC_Halt;
    fbMoveAbs  : MC_MoveAbsolute;
    fbhome     : MC_Home;
    fbRead     : MC_ReadActualPosition;               
    nErrID     : UDINT;               
    fbReset    : MC_Reset;
	eState	   : ENUM_StepperMotorState := LAS_Stepper_Uninitialized;    
	
	// Hardware check variables
	eHardwareCheckState : ENUM_HardwareCheckState;
	fHW_OriginalPosition : LREAL;
	fHW_TestPosition : LREAL;
	fHW_CurrentPosition : LREAL;
	fHW_TestDistance : LREAL := 1.5;
	fHW_PositionTolerance : LREAL := 1.0;
	fHW_UpperLimit : LREAL;
	bHW_MovePositive : BOOL;
	bHW_MovementDetected : BOOL;
	bHW_CheckStarted : BOOL;
	fbHW_Timer : TON;
	eHW_SavedState : ENUM_StepperMotorState; // Save original state
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CheckHardware" Id="{9483b802-41e4-45b6-80c4-0c5089e14c23}">
      <Declaration><![CDATA[METHOD CheckHardware : INT
VAR
    fOriginalPosition : LREAL;
    fTestPosition : LREAL;
    fCurrentPosition : LREAL;
    fTestDistance : LREAL := 1.5; // Test movement distance in mm
    fUpperLimit : LREAL;
    bMovePositive : BOOL;
    nMoveResult : INT;
    nReturnResult : INT;
    bMovementDetected : BOOL;
    fPositionTolerance : LREAL := 2.0; // Minimum detectable movement
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckHardware := 0; 

GetPosition(fCurrentPosition => fOriginalPosition);

CASE nRail OF
    1: fUpperLimit := Pos15; 
    2: fUpperLimit := Pos22;   
    3: fUpperLimit := Pos35; 
    4: fUpperLimit := Pos42;  
    ELSE
        RETURN; 
END_CASE

IF (fOriginalPosition + fTestDistance) <= fUpperLimit THEN
    bMovePositive := TRUE;
    fTestPosition := fOriginalPosition + fTestDistance;
ELSIF (fOriginalPosition - fTestDistance) >= 0.0 THEN
    bMovePositive := FALSE;
    fTestPosition := fOriginalPosition - fTestDistance;
ELSE
    RETURN; 
END_IF

nMoveResult := MoveToPosition(fPosition := fTestPosition);

CASE nMoveResult OF
	0:
		RETURN; //Continue
	
	1:
		GetPosition(fCurrentPosition => fCurrentPosition);
		IF fCurrentPosition < 0 THEN
			Checkhardware := -1;
			RETURN; // Could not read final position, hardware check fails
		END_IF

	
	-1:
		Checkhardware := -1;
		RETURN;
END_CASE

// Check if movement was detected
IF bMovePositive THEN
    bMovementDetected := (fCurrentPosition - fOriginalPosition) >= fPositionTolerance;
ELSE
    bMovementDetected := (fOriginalPosition - fCurrentPosition) >= fPositionTolerance;
END_IF

IF NOT bMovementDetected THEN
	Checkhardware := -1;
    RETURN;
END_IF

// Return to original position
nReturnResult := MoveToPosition(fPosition := fOriginalPosition);

CASE nReturnResult OF
	0:
		RETURN; //Continue
	
	1:
		GetPosition(fCurrentPosition => fCurrentPosition);
		IF fCurrentPosition < 0 THEN
			Checkhardware := -1;
			RETURN; // Could not read final position, hardware check fails
		END_IF
	
	-1:
		Checkhardware := -1;
		RETURN;
END_CASE

// All tests passed
CheckHardware := 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{aae538f2-84d5-46d9-a4e2-9cefceb9bd59}">
      <Declaration><![CDATA[METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; 
    bInCopyCode: BOOL;  
	init_axis : POINTER TO AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pAxis := init_axis;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetPosition" Id="{c99d767f-ea4a-49f6-ba95-aa6815963f09}">
      <Declaration><![CDATA[METHOD GetPosition : BOOL
VAR
	pAlarmCondition : POINTER TO BOOL;
END_VAR
VAR_OUTPUT
	fCurrentPosition : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Init(Axis := pAxis);
fRead(Axis := pAxis^, Enable := TRUE, Position => fCurrentPosition);

IF fRead.Busy THEN
	IF fRead.Error THEN
		pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'UnableToReadPosition');
		IF pAlarmCondition <> 0 THEN
			pAlarmCondition^ := TRUE;
		END_IF
	END_IF

ELSE
	IF NOT fRead.Valid THEN
		fCurrentPosition := -1;
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home" Id="{8276e0ce-98e0-421a-babf-511ef600c743}">
      <Declaration><![CDATA[METHOD Home : INT
VAR_INPUT
    bExecute : BOOL;     
END_VAR
VAR
    Currentpos : LREAL;
	Currentpass : STRING := 'Fast';
    FastPass : ST_HomingOptions := (SearchVelocity := 50.0, SyncVelocity := 15.0);
    SlowPass : ST_HomingOptions := (SearchVelocity := 5.0, SyncVelocity := 2.0);
	ReferencePos : LREAL := 10.0;    
	bPreviousSwitchState: BOOL := FALSE;
	bFirstEdgeDetected: BOOL := FALSE;
	pAlarmCondition : POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Init(Axis := pAxis); //Keep actuator up
GetPosition(fCurrentPosition => Currentpos);

CASE eState OF
    LAS_Stepper_Idle:
        IF Currentpass = 'Fast' THEN
            fbHome(Axis := pAxis^, Execute := TRUE, HomingMode := 0, Position := ReferencePos, bCalibrationCam := NOT bSimulatedLimitSwitch, Options := FastPass);
            eState := LAS_Stepper_FastPass;
            
        ELSIF Currentpass = 'Slow' THEN
            fbHome(Axis := pAxis^, Execute := TRUE, HomingMode := 0, Position := ReferencePos, bCalibrationCam := NOT bSimulatedLimitSwitch, Options := SlowPass);
            eState := LAS_Stepper_SlowPass;
        END_IF
        
    LAS_Stepper_FastPass:
        fbHome(Axis := pAxis^, bCalibrationCam := NOT bSimulatedLimitSwitch);
        
        IF fbHome.Error THEN
			(*IF fbHome.ErrorID = 16#00004B0A THEN
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Homing_Interrupted');
				IF pAlarmCondition <> 0 THEN
					pAlarmCondition^ := TRUE;
				END_IF
				
				Home := -1;
				RETURN;
			END_IF*)
			
            eState := LAS_Stepper_Error;
            
			pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Homing_Failed');
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
				
            nErrID := fbHome.ErrorID;
            Home := -1;

        ELSIF fbHome.Done THEN
            fbHome(Axis := pAxis^, Execute := FALSE);
            eState := LAS_Stepper_WaitingForTrigger;
        END_IF
    
    LAS_Stepper_WaitingForTrigger: // Wait for the limit switch

        IF NOT bSimulatedLimitSwitch THEN

            fbHome(Axis := pAxis^, Execute := TRUE, HomingMode := 0, Position := ReferencePos, bCalibrationCam := NOT bSimulatedLimitSwitch, Options := SlowPass);
            eState := LAS_Stepper_SlowPass;
        END_IF
    
    LAS_Stepper_SlowPass:
        fbHome(Axis := pAxis^, bCalibrationCam := NOT bSimulatedLimitSwitch);
        
        IF fbHome.Error THEN
			(*IF fbHome.ErrorID = 16#00004B0A THEN
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Homing_Interrupted');
				IF pAlarmCondition <> 0 THEN
					pAlarmCondition^ := TRUE;
				END_IF
				
				Home := -1;
				RETURN;
			END_IF*)
			
            eState := LAS_Stepper_Error;
            
			pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Homing_Failed');
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
			
            nErrID := fbHome.ErrorID;
            Home := -1;
			
        ELSIF fbHome.Done THEN
            fbHome(Axis := pAxis^, Execute := FALSE);
            Currentpass := 'Fast';
            Home := 1; 
            eState := LAS_Stepper_Idle;
        END_IF
    
    LAS_Stepper_Error:
        Home := -1;
        
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{fa5103ef-9b92-4848-8e64-2a4a389deecc}">
      <Declaration><![CDATA[METHOD Init : BOOL
VAR_INPUT
	Axis : POINTER TO AXIS_REF;  
END_VAR

VAR
	pAlarmCondition : POINTER TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pAxis := Axis; 

CASE eState OF 
    LAS_Stepper_Uninitialized:
        fbPower(Axis := pAxis^, Enable := TRUE, Enable_positive := TRUE, Enable_Negative := TRUE);
        
		IF fbPower.Status THEN
			Init := TRUE; 
			eState := LAS_Stepper_Idle;
			nErrID := 0;
			//Enable := FALSE;
			
		ELSIF fbPower.Error THEN	
			nErrID := fbPower.ErrorID;
			eState := LAS_Stepper_Error;
			
			pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'PowerUp_Failed');
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
			
			Init := FALSE;
			//Enable := FALSE;
		END_IF
      
	  ELSE
	  	
	  	fbPower(Axis := pAxis^, Enable := TRUE, Enable_positive := TRUE, Enable_Negative := TRUE);
		IF fbPower.Error THEN	
			nErrID := fbPower.ErrorID;
			eState := LAS_Stepper_Error;
			
			pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'PowerUp_Failed');
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
			
			Init := FALSE;
			//Enable := FALSE;
		END_IF
				
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveToPosition" Id="{59187d53-eaea-489c-80e7-2ef214427a40}">
      <Declaration><![CDATA[METHOD MoveToPosition : INT
VAR_INPUT
    fPosition : LREAL;  // Target position
    fVelocity : LREAL := 1.0;  // Velocity in mm/s
    fAccel    : LREAL := 0.5;  // Acceleration in mm/s²
    fDecel    : LREAL := 0.5;  // Deceleration in mm/s²
END_VAR

VAR
	pAlarmCondition : POINTER TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveToPosition := 0;
Init(Axis := pAxis);

CASE eState OF
	LAS_Stepper_Idle, LAS_Stepper_Hardware_Check:
		fbMoveAbs(Axis := pAxis^, Execute := TRUE, Position := fPosition, 
          Velocity := fVelocity, Acceleration := fAccel, Deceleration := fDecel);
	
		eState := LAS_Stepper_Moving;
		
	LAS_Stepper_Moving:
		IF fbMoveAbs.Busy THEN
			fbMoveAbs(Axis := pAxis^);
		END_IF
		IF fbMoveAbs.Error THEN
			eState := LAS_Stepper_Error;
			
			nErrID := fbMoveAbs.ErrorID;
			
			pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Motion_Failed');
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
			
			fbMoveAbs(Axis := pAxis^, Execute := FALSE);
			MoveToPosition := -1;
		END_IF
		
		IF fbMoveAbs.CommandAborted THEN
			eState := LAS_Stepper_Error;
			
			pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Motion_Interrupted');
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
				
			fbMoveAbs(Axis := pAxis^, Execute := FALSE);
			MoveToPosition := -1;
			
		ELSIF fbMoveAbs.Done THEN
			eState := LAS_Stepper_Idle;
			fbMoveAbs(Axis := pAxis^, Execute := FALSE);
			MoveToPosition := 1; 
			nErrID := 0;
		END_IF
	
	LAS_Stepper_Error:
		MoveToPosition := -1; 
		
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{185c3e3a-adea-4170-9d64-3a4611a9e6c3}">
      <Declaration><![CDATA[METHOD Reset : INT
VAR_INPUT
    bExecute : BOOL;
END_VAR

VAR
	i : UINT;
	pAlarmCondition : POINTER TO BOOL;
	nResult : INT;
	nMoveResult : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := 0;
Init(Axis := pAxis);

CASE eState OF
	LAS_Stepper_Error, LAS_Stepper_Idle:
		fbReset(Axis := pAxis^, Execute := bExecute);
		
		IF fbReset.Busy THEN 
			IF fbReset.Error THEN
				eState := LAS_Stepper_Error;
				nErrID := fbReset.ErrorID;
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Reset_Failed');
				IF pAlarmCondition <> 0 THEN
					pAlarmCondition^ := TRUE;
				END_IF
				
				Reset := -1;
			END_IF
		
		ELSIF fbReset.Done THEN		
			fbReset(Axis := pAxis^, Execute := FALSE);
			// Start hardware check
			eState := LAS_Stepper_Hardware_Check;
			eHardwareCheckState := HW_GetOriginalPos;
			bHW_CheckStarted := FALSE;
		END_IF
	
	LAS_Stepper_Hardware_Check, LAS_Stepper_Moving:
		// Hardware check state machine
		CASE eHardwareCheckState OF
			HW_GetOriginalPos:
				// Start timer on first entry
				IF NOT bHW_CheckStarted THEN
					bHW_CheckStarted := TRUE;
					fHW_OriginalPosition := -1;
				END_IF
				
				fbHW_Timer(IN := bHW_CheckStarted, PT := T#10S);
				
				// Get original position
				GetPosition(fCurrentPosition => fHW_OriginalPosition);
				
				IF fHW_OriginalPosition >= 0 THEN
					// Position read successfully, calculate test position
					CASE nRail OF
						1: fHW_UpperLimit := Pos15; 
						2: fHW_UpperLimit := Pos22;   
						3: fHW_UpperLimit := Pos35; 
						4: fHW_UpperLimit := Pos42;  
						ELSE
							eHardwareCheckState := HW_Failed;
					END_CASE
					
					IF eHardwareCheckState <> HW_Failed THEN
						IF (fHW_OriginalPosition + fHW_TestDistance) <= fHW_UpperLimit THEN
							bHW_MovePositive := TRUE;
							fHW_TestPosition := fHW_OriginalPosition + fHW_TestDistance;
						ELSIF (fHW_OriginalPosition - fHW_TestDistance) >= 0.0 THEN
							bHW_MovePositive := FALSE;
							fHW_TestPosition := fHW_OriginalPosition - fHW_TestDistance;
						ELSE
							// Cannot perform hardware check at this position
							eHardwareCheckState := HW_Failed;
						END_IF
						
						IF eHardwareCheckState <> HW_Failed THEN
							eHardwareCheckState := HW_StartTestMove;
						END_IF
					END_IF
					
				ELSIF fbHW_Timer.Q THEN
					// Timeout getting position
					eHardwareCheckState := HW_Failed;
				END_IF
			
			HW_StartTestMove:
				// MoveToPosition already handles LAS_Stepper_Hardware_Check
				eHardwareCheckState := HW_WaitTestMove;
			
			HW_WaitTestMove:
				fbHW_Timer(IN := bHW_CheckStarted, PT := T#10S);
				
				nMoveResult := MoveToPosition(fPosition := fHW_TestPosition);
				
				CASE nMoveResult OF
					0: // Continue
						// Check timeout
						(*IF fbHW_Timer.Q THEN
							eHardwareCheckState := HW_Failed;
						END_IF*)
						
					1: // Move completed successfully
						eState := LAS_Stepper_Hardware_Check; // Ensure we stay in hardware check
						eHardwareCheckState := HW_CheckMovement;
						
					-1: // Move failed
						eHardwareCheckState := HW_Failed;
				END_CASE
			
			HW_CheckMovement:
				fbHW_Timer(IN := bHW_CheckStarted, PT := T#10S);
				
				// Get current position after move
				GetPosition(fCurrentPosition => fHW_CurrentPosition);
				
				IF fHW_CurrentPosition >= 0 THEN
					// Check if movement was detected
					IF bHW_MovePositive THEN
						bHW_MovementDetected := (fHW_CurrentPosition - fHW_OriginalPosition) >= fHW_PositionTolerance;
					ELSE
						bHW_MovementDetected := (fHW_OriginalPosition - fHW_CurrentPosition) >= fHW_PositionTolerance;
					END_IF
					
					IF NOT bHW_MovementDetected THEN
						// Hardware check failed - no movement detected
						eHardwareCheckState := HW_Failed;
					ELSE
						// Movement detected, return to original position
						eHardwareCheckState := HW_StartReturn;
					END_IF
					
				(*ELSIF fbHW_Timer.Q THEN
					// Timeout reading position
					eHardwareCheckState := HW_Failed;*)
				END_IF
			
			HW_StartReturn:
				// MoveToPosition already handles LAS_Stepper_Hardware_Check  
				eHardwareCheckState := HW_WaitReturn;
			
			HW_WaitReturn:
				fbHW_Timer(IN := bHW_CheckStarted, PT := T#10S);
				
				nMoveResult := MoveToPosition(fPosition := fHW_OriginalPosition);
				
				CASE nMoveResult OF
					0: // Continue
						// Check timeout
						(*IF fbHW_Timer.Q THEN
							eHardwareCheckState := HW_Failed;
						END_IF*)
						
					1: // Return completed successfully
						eState := LAS_Stepper_Hardware_Check; // Ensure we stay in hardware check
						eHardwareCheckState := HW_Complete;
						
					-1: // Return failed
						eHardwareCheckState := HW_Failed;
				END_CASE
			
			HW_Complete:
				// Hardware check completed successfully
				eState := LAS_Stepper_Idle;
				bHW_CheckStarted := FALSE;
				
				// Clear all alarm conditions
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Motion_Failed');
				IF pAlarmCondition <> 0 THEN pAlarmCondition^ := FALSE; END_IF
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Homing_Failed');
				IF pAlarmCondition <> 0 THEN pAlarmCondition^ := FALSE; END_IF
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Motion_Interrupted');
				IF pAlarmCondition <> 0 THEN pAlarmCondition^ := FALSE; END_IF
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'PowerUp_Failed');
				IF pAlarmCondition <> 0 THEN pAlarmCondition^ := FALSE; END_IF
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Reset_Failed');
				IF pAlarmCondition <> 0 THEN pAlarmCondition^ := FALSE; END_IF
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Stop_Failed');
				IF pAlarmCondition <> 0 THEN pAlarmCondition^ := FALSE; END_IF
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'UnableToReadPosition');
				IF pAlarmCondition <> 0 THEN pAlarmCondition^ := FALSE; END_IF
				
				Reset := 1;
			
			HW_Failed:
				eState := LAS_Stepper_Error;
				bHW_CheckStarted := FALSE;
				
				pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Reset_Failed');
				IF pAlarmCondition <> 0 THEN
					pAlarmCondition^ := TRUE;
				END_IF
				
				Reset := -1;
		END_CASE
	
	ELSE
		// Unknown state during reset
		Reset := -1;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{9b515f94-46a2-4ab1-aca0-af2dcdfe9f04}">
      <Declaration><![CDATA[METHOD Stop : INT
VAR_INPUT
    bEnable : BOOL;
	fDecel    : LREAL := 500.0;
END_VAR

VAR
	pAlarmCondition : POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stop := 0;
Init(Axis := pAxis);

CASE eState OF
    LAS_Stepper_Idle:
        // Already stopped
        Stop := 1;
        
    LAS_Stepper_Moving:
        fbStop(Axis := pAxis^, Execute := bEnable, Deceleration := fDecel);
              
		IF fbStop.Error THEN
			fbStop(Axis := pAxis^, Execute := FALSE);
			eState := LAS_Stepper_Error;
			nErrID := fbStop.ErrorID;
			
			pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Stop_Failed');
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
			
			Stop := -1;
            
        ELSIF fbStop.Done THEN
			fbStop(Axis := pAxis^, Execute := FALSE);
			fbMoveAbs(Axis := pAxis^, Execute := FALSE);
            eState := LAS_Stepper_Idle;
            Stop := 1; 
            nErrID := 0;
		END_IF
    
    LAS_Stepper_FastPass, LAS_Stepper_SlowPass, LAS_Stepper_WaitingForTrigger :
	
	   fbStop(Axis := pAxis^, Execute := TRUE, Deceleration := fDecel);
	   
	   IF fbStop.Done THEN
		   fbStop(Axis := pAxis^, Execute := FALSE);
		   fbHome(Axis := pAxis^, Execute := FALSE);
		   fbReset(Axis := pAxis^, Execute := TRUE);
		   IF fbReset.Done THEN
		       fbReset(Axis := pAxis^, Execute := FALSE);
			   eState := LAS_Stepper_Idle;
		   	   Stop   := 1;          
	   	   END_IF
	   ELSIF fbStop.Error THEN
			eState := LAS_Stepper_Error;
			nErrID := fbStop.ErrorID;
			Stop   := -1;
	   END_IF
    
    LAS_Stepper_Error:
        Stop := -1;        
        
    ELSE
        // Unknown state
        fbStop(Axis := pAxis^, Execute := bEnable, Deceleration := fDecel);
        IF fbStop.Done THEN
            eState := LAS_Stepper_Idle;
            Stop := 1;
        ELSIF fbStop.Error THEN
            eState := LAS_Stepper_Error;
            nErrID := fbStop.ErrorID;
			
			pAlarmCondition := F_GetStepperAlarmCondition(nRail, 'Stop_Failed');
			IF pAlarmCondition <> 0 THEN
				pAlarmCondition^ := TRUE;
			END_IF
			
            Stop := -1;
        END_IF
        
END_CASE

]]></ST>
      </Implementation>
    </Method>
