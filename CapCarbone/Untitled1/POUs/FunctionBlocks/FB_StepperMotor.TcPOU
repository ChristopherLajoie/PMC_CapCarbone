<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="FB_StepperMotor" Id="{bbe3d249-0f45-4d4f-9e26-26a436162bb5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StepperMotor
VAR_INPUT
	nRail 	   : SINT := 0;
END_VAR
VAR
	pAxis : POINTER TO AXIS_REF;
	fRead : MC_ReadActualPosition;
    fbPower    : MC_Power;
    fbstop     : MC_Halt;
    fbMoveAbs  : MC_MoveAbsolute;
    fbhome     : MC_Home;
    fbRead     : MC_ReadActualPosition;               
    nErrID     : UDINT;               
    fbReset    : MC_Reset;
	eState	   : ENUM_StepperMotorState := LAS_Stepper_Uninitialized;    
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CanReset" Id="{ae20159f-e14a-44fa-b0a2-97b4ba5a70bf}">
      <Declaration><![CDATA[METHOD CanReset : BOOL
VAR
    bAllAlarmsAcked : BOOL := TRUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF eState <> LAS_Stepper_Error THEN
    CanReset := TRUE;
    RETURN;
END_IF

// Check all stepper-related alarms for this rail are acknowledged
CASE nRail OF
    1: // Rail 1 stepper alarms
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R1_Stepper_Motion_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R1_Stepper_Homing_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R1_Stepper_Homing_Interrupted.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R1_Stepper_Motion_Interrupted.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R1_Stepper_PowerUp_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R1_Stepper_Reset_Failed.bAcked;
        
    2: // Rail 2 stepper alarms
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R2_Stepper_PowerUp_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R2_Stepper_Homing_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R2_Stepper_Homing_Interrupted.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R2_Stepper_Motion_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R2_Stepper_Motion_Interrupted.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R2_Stepper_Reset_Failed.bAcked;
        
    3: // Rail 3 stepper alarms
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R3_Stepper_PowerUp_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R3_Stepper_Homing_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R3_Stepper_Homing_Interrupted.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R3_Stepper_Motion_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R3_Stepper_Motion_Interrupted.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R3_Stepper_Reset_Failed.bAcked;
        
    4: // Rail 4 stepper alarms
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R4_Stepper_PowerUp_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R4_Stepper_Homing_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R4_Stepper_Homing_Interrupted.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R4_Stepper_Motion_Failed.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R4_Stepper_Motion_Interrupted.bAcked;
        bAllAlarmsAcked := bAllAlarmsAcked AND GVL_Alarms.R4_Stepper_Reset_Failed.bAcked;
        
    ELSE
        bAllAlarmsAcked := FALSE; // Invalid rail number
END_CASE

CanReset := bAllAlarmsAcked;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{aae538f2-84d5-46d9-a4e2-9cefceb9bd59}">
      <Declaration><![CDATA[METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
	init_axis : POINTER TO AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pAxis := init_axis;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetPosition" Id="{c99d767f-ea4a-49f6-ba95-aa6815963f09}">
      <Declaration><![CDATA[METHOD GetPosition : BOOL
VAR_OUTPUT
	fCurrentPosition : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Init(Axis := pAxis);
fRead(Axis := pAxis^, Enable := TRUE, Position => fCurrentPosition);

IF fRead.Busy THEN
	IF fRead.Error THEN
		//Alarm for error reading
	END_IF

ELSE
	IF NOT fRead.Valid THEN
		fCurrentPosition := -1;
	END_IF
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home" Id="{8276e0ce-98e0-421a-babf-511ef600c743}">
      <Declaration><![CDATA[METHOD Home : INT
VAR_INPUT
    bExecute : BOOL;     
END_VAR
VAR
    Currentpos : LREAL;
	Currentpass : STRING := 'Fast';
    FastPass : ST_HomingOptions := (SearchVelocity := 50.0, SyncVelocity := 15.0);
    SlowPass : ST_HomingOptions := (SearchVelocity := 5.0, SyncVelocity := 2.0);
	ReferencePos : LREAL := 10.0;    
	bPreviousSwitchState: BOOL := FALSE;
	bFirstEdgeDetected: BOOL := FALSE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Init(Axis := pAxis);
GetPosition(fCurrentPosition => Currentpos);

CASE eState OF
    LAS_Stepper_Idle:
        IF Currentpass = 'Fast' THEN
            fbHome(Axis := pAxis^, Execute := TRUE, HomingMode := 0, Position := ReferencePos, bCalibrationCam := NOT bSimulatedLimitSwitch, Options := FastPass);
            eState := LAS_Stepper_FastPass;
            
        ELSIF Currentpass = 'Slow' THEN
            fbHome(Axis := pAxis^, Execute := TRUE, HomingMode := 0, Position := ReferencePos, bCalibrationCam := NOT bSimulatedLimitSwitch, Options := SlowPass);
            eState := LAS_Stepper_SlowPass;
        END_IF
        
    LAS_Stepper_FastPass:
        fbHome(Axis := pAxis^, bCalibrationCam := NOT bSimulatedLimitSwitch);
        
        IF fbHome.Error THEN
			IF fbHome.ErrorID = 16#00004B0A THEN
				//StepperMotorHomeOperationInterrupted := TRUE;
				Home := -1;
				RETURN;
			END_IF
			
            eState := LAS_Stepper_Error;
            //StepperMotorHomeOperationFailed := TRUE;
            nErrID := fbHome.ErrorID;
            Home := -1;

        ELSIF fbHome.Done THEN
            fbHome(Axis := pAxis^, Execute := FALSE);
            
            // Instead of starting slow pass immediately, transition to waiting state
            eState := LAS_Stepper_WaitingForTrigger;
        END_IF
    
    LAS_Stepper_WaitingForTrigger:
        // Wait for the limit switch to be false before starting slow pass
        IF NOT bSimulatedLimitSwitch THEN
            // Now that the switch is false, start the slow pass
            fbHome(Axis := pAxis^, Execute := TRUE, HomingMode := 0, Position := ReferencePos, bCalibrationCam := NOT bSimulatedLimitSwitch, Options := SlowPass);
            eState := LAS_Stepper_SlowPass;
        END_IF
    
    LAS_Stepper_SlowPass:
        fbHome(Axis := pAxis^, bCalibrationCam := NOT bSimulatedLimitSwitch);
        
        IF fbHome.Error THEN
			IF fbHome.ErrorID = 16#00004B0A THEN
				//StepperMotorHomeOperationInterrupted := TRUE;
				Home := -1;
				RETURN;
			END_IF
			
            eState := LAS_Stepper_Error;
            //StepperMotorHomeOperationFailed := TRUE;
            nErrID := fbHome.ErrorID;
            Home := -1;
			
        ELSIF fbHome.Done THEN
            fbHome(Axis := pAxis^, Execute := FALSE);
            Currentpass := 'Fast';
            Home := 1; 
            eState := LAS_Stepper_Idle;
        END_IF
    
    LAS_Stepper_Error:
        Home := -1;
		IF CanReset() THEN
			Reset(bExecute := TRUE);
        END_IF
        
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{fa5103ef-9b92-4848-8e64-2a4a389deecc}">
      <Declaration><![CDATA[METHOD Init : BOOL
VAR_INPUT
	Axis : POINTER TO AXIS_REF;  // Parameter for initialization
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pAxis := Axis; 

CASE eState OF 
    LAS_Stepper_Uninitialized:
        fbPower(Axis := pAxis^, Enable := TRUE, Enable_positive := TRUE, Enable_Negative := TRUE);
        
		IF fbPower.Status THEN
			Init := TRUE; 
			eState := LAS_Stepper_Idle;
			nErrID := 0;
			//Enable := FALSE;
			
		ELSIF fbPower.Error THEN	
			nErrID := fbPower.ErrorID;
			eState := LAS_Stepper_Error;
			//StepperMotorPowerUpFailed := TRUE;
			Init := FALSE;
			//Enable := FALSE;
		END_IF
      
	  ELSE
	  	
	  	fbPower(Axis := pAxis^, Enable := TRUE, Enable_positive := TRUE, Enable_Negative := TRUE);
		IF fbPower.Error THEN	
			nErrID := fbPower.ErrorID;
			eState := LAS_Stepper_Error;
			//StepperMotorPowerUpFailed := TRUE;
			Init := FALSE;
			//Enable := FALSE;
		END_IF
				
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveToPosition" Id="{59187d53-eaea-489c-80e7-2ef214427a40}">
      <Declaration><![CDATA[METHOD MoveToPosition : INT
VAR_INPUT
    fPosition : LREAL;  // Target position
    fVelocity : LREAL := 100.0;  // Velocity in mm/s
    fAccel    : LREAL := 500.0;  // Acceleration in mm/s²
    fDecel    : LREAL := 500.0;  // Deceleration in mm/s²
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveToPosition := 0;
Init(Axis := pAxis);
CASE eState OF
	LAS_Stepper_Idle:
		fbMoveAbs(Axis := pAxis^, Execute := TRUE, Position := fPosition, 
          Velocity := fVelocity, Acceleration := fAccel, Deceleration := fDecel);
	
		eState := LAS_Stepper_Moving;
		
	LAS_Stepper_Moving:
		IF fbMoveAbs.Busy THEN
			fbMoveAbs(Axis := pAxis^);
			IF fbMoveAbs.Error THEN
				eState := LAS_Stepper_Error;
				
				nErrID := fbMoveAbs.ErrorID;
				//StepperMotorMotionOperationFailed := TRUE;
				MoveToPosition := -1;
			END_IF
		
		ELSIF fbMoveAbs.CommandAborted THEN
			eState := LAS_Stepper_Error;
			//StepperMotorMotionOperationInterrupted := TRUE;
			fbMoveAbs(Axis := pAxis^, Execute := FALSE);
			MoveToPosition := -1;
			
		ELSIF fbMoveAbs.Done THEN
			eState := LAS_Stepper_Idle;
			fbMoveAbs(Axis := pAxis^, Execute := FALSE);
			MoveToPosition := 1; 
			nErrID := 0;
		END_IF
	
	LAS_STEPPER_ERROR:
		MoveToPosition := -1; 
		IF CanReset() THEN
			Reset(bExecute := TRUE);
		END_IF
		
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{185c3e3a-adea-4170-9d64-3a4611a9e6c3}">
      <Declaration><![CDATA[METHOD Reset : INT
VAR_INPUT
    bExecute : BOOL;
END_VAR

VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := 0;
Init(Axis := pAxis);
IF eState = LAS_Stepper_Error THEN
	fbReset(Axis := pAxis^, Execute := bExecute);
	
	IF fbReset.Busy THEN 
		IF fbReset.Error THEN
			
		eState := LAS_Stepper_Error;
		nErrID := fbReset.ErrorID;
		
		//StepperMotorResetOperationFailed := TRUE;
		Reset := -1;
		END_IF
	
	ELSIF fbReset.Done THEN
		Reset := 1;
		
		IF fbPower.Status THEN
			eState := LAS_Stepper_Idle;
			
			//Reset all error flags?
			
		ELSE
			eState := LAS_Stepper_Uninitialized;
		END_IF
		
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{9b515f94-46a2-4ab1-aca0-af2dcdfe9f04}">
      <Declaration><![CDATA[METHOD Stop : INT
VAR_INPUT
    bEnable : BOOL;
	fDecel    : LREAL := 500.0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stop := 0;
Init(Axis := pAxis);

CASE eState OF
    LAS_Stepper_Idle:
        // Stepper is already stopped
        Stop := 1;
        
    LAS_Stepper_Moving:
        // Normal movement stop - existing logic
        fbStop(Axis := pAxis^, Execute := bEnable, Deceleration := fDecel);
        
       
		IF fbStop.Error THEN
			fbStop(Axis := pAxis^, Execute := FALSE);
			eState := LAS_Stepper_Error;
			nErrID := fbStop.ErrorID;
			Stop := -1;
            
        ELSIF fbStop.Done THEN
			fbStop(Axis := pAxis^, Execute := FALSE);
			fbMoveAbs(Axis := pAxis^, Execute := FALSE);
            eState := LAS_Stepper_Idle;
            Stop := 1; 
            nErrID := 0;
		END_IF
    
    // ========================================================================
    // NEW: Handle all homing states
    // ========================================================================
    LAS_Stepper_FastPass, LAS_Stepper_SlowPass, LAS_Stepper_WaitingForTrigger :
	
	   fbStop(Axis := pAxis^, Execute := TRUE, Deceleration := fDecel);
	   
	   IF fbStop.Done THEN
		   fbStop(Axis := pAxis^, Execute := FALSE);
		   fbHome(Axis := pAxis^, Execute := FALSE);
		   fbReset(Axis := pAxis^, Execute := TRUE);
		   IF fbReset.Done THEN
		       fbReset(Axis := pAxis^, Execute := FALSE);
			   eState := LAS_Stepper_Idle;
		   	   Stop   := 1;          (* “cancelled cleanly” *)
	   	   END_IF
	   ELSIF fbStop.Error THEN
			eState := LAS_Stepper_Error;
			nErrID := fbStop.ErrorID;
			Stop   := -1;
	   END_IF
    
    LAS_Stepper_Error:
        Stop := -1;
        IF CanReset() THEN
            Reset(bExecute := TRUE);
        END_IF
        
    LAS_Stepper_Offline:
        // Can't stop if offline
        Stop := -1;
        
    ELSE
        // Unknown state - try to get to safe state
        fbStop(Axis := pAxis^, Execute := bEnable, Deceleration := fDecel);
        IF fbStop.Done THEN
            eState := LAS_Stepper_Idle;
            Stop := 1;
        ELSIF fbStop.Error THEN
            eState := LAS_Stepper_Error;
            nErrID := fbStop.ErrorID;
            Stop := -1;
        END_IF
        
END_CASE

]]></ST>
      </Implementation>
    </Method>
