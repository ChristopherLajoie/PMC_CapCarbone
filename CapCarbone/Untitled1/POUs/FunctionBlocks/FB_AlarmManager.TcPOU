<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="FB_AlarmManager" Id="{1c3d755c-8084-4b18-aa10-c5b49d9c9e6b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AlarmManager
VAR_INPUT
    bEnable         : BOOL := TRUE;    // Enable the alarm manager
END_VAR
VAR_OUTPUT
    nActiveCount    : UINT;            // Count of active alarms
    nUnackedCount   : UINT;            // Count of unacknowledged alarms
END_VAR
VAR
    aAlarmPrevState : ARRAY[1..20] OF BOOL; // Previous state of each alarm condition
    nConfiguredAlarms : UINT := 0;     // Number of configured alarms (determined at runtime)
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Execute" Id="{30fb5a1e-6341-4ac7-8fe9-b6a5414b5ea9}">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bEnable THEN
	ProcessAlarms();
END_IF
    
Execute := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{fbb659af-fc45-4ac7-9063-91745f13da7e}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
END_VAR

VAR
	i : UINT; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Initialize previous states
FOR i := 1 TO MAX_ALARMS DO
	aAlarmPrevState[i] := FALSE;
END_FOR

// Count the number of configured alarms
nConfiguredAlarms := 0;
FOR i := 1 TO MAX_ALARMS DO
	// Consider an alarm configured if it has a non-zero ID
	IF AlarmArray[i].nID <> 0 THEN
		nConfiguredAlarms := i;
	END_IF
END_FOR

// Return success
FB_init := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAlarms" Id="{d8b82382-c457-4aa2-bba1-c00c8e2e71c3}">
      <Declaration><![CDATA[METHOD ProcessAlarms : BOOL
VAR
    i : UINT;
    bRisingEdge : BOOL;
    bFallingEdge : BOOL;
    ulCurrentTime : ULINT;
	sTemp : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset counters
nActiveCount := 0;
nUnackedCount := 0;

// Get current system time
ulCurrentTime := F_GetSystemTime();

// Process each configured alarm
FOR i := 1 TO nConfiguredAlarms DO
	// Skip processing if the alarm is not configured (ID = 0)
	IF AlarmArray[i].nID = 0 THEN
		CONTINUE;
	END_IF

	// Calculate edge conditions
	bRisingEdge := NOT aAlarmPrevState[i] AND AlarmArray[i].bCondition;
	bFallingEdge := aAlarmPrevState[i] AND NOT AlarmArray[i].bCondition;
	
	// Process alarm activation
	IF bRisingEdge THEN
		AlarmArray[i].bActive := TRUE;
		AlarmArray[i].bAcked := FALSE;
		AlarmArray[i].nTimestamp := ulCurrentTime;
		
		// If this alarm might have an associated error ID (message ends with ':')
        IF RIGHT(AlarmArray[i].sMessage, 1) = ':' THEN
            // Get the error ID from the global array
            AlarmArray[i].nID := g_AlarmErrorIDs[i];
            
            // Only append if there's actually an error ID
            IF AlarmArray[i].nID <> 0 THEN
				sTemp := CONCAT(AlarmArray[i].sMessage, ' ');
                AlarmArray[i].sDynamicMessage := CONCAT(
                    sTemp,
                    UDINT_TO_STRING(AlarmArray[i].nID)
                );
            ELSE
                AlarmArray[i].sDynamicMessage := AlarmArray[i].sMessage;
            END_IF
        ELSE
            // For standard messages, just use the original
            AlarmArray[i].sDynamicMessage := AlarmArray[i].sMessage;
        END_IF
	END_IF
	
	// Process alarm deactivation
	IF bFallingEdge THEN
		AlarmArray[i].bActive := FALSE;
	END_IF
	
	// Process acknowledgment requests from OPC UA
	IF AlarmArray[i].bAckRequest AND AlarmArray[i].bActive AND NOT AlarmArray[i].bAcked THEN
		AlarmArray[i].bAcked := TRUE;
		AlarmArray[i].nAckTimestamp := ulCurrentTime;
		AlarmArray[i].bAckRequest := FALSE; // Reset the request flag
	END_IF
	
	// Store current state for next cycle
	aAlarmPrevState[i] := AlarmArray[i].bCondition;
	
	// Update counters
	IF AlarmArray[i].bActive THEN
		nActiveCount := nActiveCount + 1;
		IF NOT AlarmArray[i].bAcked THEN
			nUnackedCount := nUnackedCount + 1;
		END_IF
	END_IF
END_FOR

// Update global counters
g_nActiveAlarms := nActiveCount;
g_nUnackedAlarms := nUnackedCount;

ProcessAlarms := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAlarmCondition" Id="{e55506a6-2167-4718-b401-bb3689092b8f}">
      <Declaration><![CDATA[METHOD SetAlarmCondition : BOOL
VAR_INPUT
    nIndex      : UINT;        // Index in the alarm array (1-20)
    bCondition  : BOOL;        // Current state of the alarm condition
END_VAR
VAR
    i           : UINT;        // Loop counter
    bFound      : BOOL := FALSE; // Flag to indicate if alarm was found
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ FOR i := 1 TO MAX_ALARMS DO
        IF AlarmArray[i].nID = nIndex THEN
            AlarmArray[i].bCondition := bCondition;
            bFound := TRUE;
            EXIT;  
        END_IF
    END_FOR
    
    SetAlarmCondition := bFound;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_AlarmManager">
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FB_AlarmManager.Execute">
      <LineId Id="1" Count="4" />
    </LineIds>
    <LineIds Name="FB_AlarmManager.FB_init">
      <LineId Id="1" Count="15" />
    </LineIds>
    <LineIds Name="FB_AlarmManager.ProcessAlarms">
      <LineId Id="1" Count="73" />
    </LineIds>
    <LineIds Name="FB_AlarmManager.SetAlarmCondition">
      <LineId Id="1" Count="8" />
    </LineIds>
  </POU>
</TcPlcObject>