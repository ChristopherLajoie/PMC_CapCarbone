<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="FB_AlarmStatusManager" Id="{05451d1b-b510-43ab-83d4-ae190ad58e7b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AlarmStatusManager
VAR_INPUT
    bMaintenanceMode : BOOL;  // Enable maintenance override
END_VAR

VAR_OUTPUT
    stSystemStatus : ST_SystemAlarmStatus;  // Complete system status
END_VAR

VAR
    i : INT;
    bFirstRun : BOOL := TRUE;
    
    // Simple alarm mapping - just alarm pointer and zone number
    aZoneAlarmMap : ARRAY[1..50] OF ST_AlarmZoneMap;
    aGlobalAlarmMap : ARRAY[1..10] OF ST_AlarmZoneMap;
    nZoneAlarmCount : INT := 0;
    nGlobalAlarmCount : INT := 0;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// MAIN IMPLEMENTATION
// ============================================================================
// INITIALIZE ALARM MAPPING (First run only)
// ============================================================================
IF bFirstRun THEN
    InitializeAlarmMapping();
    bFirstRun := FALSE;
END_IF

// ============================================================================
// RESET ALL ZONES TO OK
// ============================================================================
FOR i := 1 TO 4 DO
    stSystemStatus.aZoneStatus[i].bOkToRun := TRUE;
    stSystemStatus.aZoneStatus[i].nHighestSeverity := 0;
END_FOR

stSystemStatus.bGlobalOkToRun := TRUE;
stSystemStatus.bAllZonesOk := TRUE;
stSystemStatus.bMaintenanceMode := bMaintenanceMode;

// ============================================================================
// PROCESS ALL ZONE ALARMS WITH LOOP
// ============================================================================
FOR i := 1 TO nZoneAlarmCount DO
    ProcessZoneAlarm(aZoneAlarmMap[i]);
END_FOR

// ============================================================================
// PROCESS ALL GLOBAL ALARMS WITH LOOP  
// ============================================================================
FOR i := 1 TO nGlobalAlarmCount DO
    ProcessGlobalAlarm(aGlobalAlarmMap[i]);
END_FOR

// ============================================================================
// CALCULATE FINAL SYSTEM STATUS
// ============================================================================
stSystemStatus.bAllZonesOk := 
    stSystemStatus.aZoneStatus[1].bOkToRun AND 
    stSystemStatus.aZoneStatus[2].bOkToRun AND 
    stSystemStatus.aZoneStatus[3].bOkToRun AND 
    stSystemStatus.aZoneStatus[4].bOkToRun;]]></ST>
    </Implementation>
    <Method Name="AddGlobalAlarmMap" Id="{56d5821f-0579-476b-ba8f-df5f4e0e136c}">
      <Declaration><![CDATA[METHOD AddGlobalAlarmMap : BOOL
VAR_INPUT
    pAlarm : POINTER TO ST_Alarm;      // Pointer to your existing ST_Alarm
    pOpcActive : POINTER TO BOOL;      // Pointer to OPC UA IsActive
    pOpcShelved : POINTER TO BOOL;     // Pointer to OPC UA IsShelved
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nGlobalAlarmCount >= 10 THEN
    AddGlobalAlarmMap := FALSE;
    RETURN;
END_IF

nGlobalAlarmCount := nGlobalAlarmCount + 1;
aGlobalAlarmMap[nGlobalAlarmCount].pAlarm := pAlarm;
aGlobalAlarmMap[nGlobalAlarmCount].pOpcActive := pOpcActive;
aGlobalAlarmMap[nGlobalAlarmCount].pOpcShelved := pOpcShelved;
aGlobalAlarmMap[nGlobalAlarmCount].nZone := 0;  // Global

AddGlobalAlarmMap := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddZoneAlarmMap" Id="{579d4c7d-f24b-4527-b246-e584412bf718}">
      <Declaration><![CDATA[METHOD AddZoneAlarmMap : BOOL
VAR_INPUT
    pAlarm : POINTER TO ST_Alarm;      // Pointer to your existing ST_Alarm
    pOpcActive : POINTER TO BOOL;      // Pointer to OPC UA IsActive
    pOpcShelved : POINTER TO BOOL;     // Pointer to OPC UA IsShelved  
    nZone : SINT;                      // Zone number
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF nZoneAlarmCount >= 50 THEN
    AddZoneAlarmMap := FALSE;
    RETURN;
END_IF

nZoneAlarmCount := nZoneAlarmCount + 1;
aZoneAlarmMap[nZoneAlarmCount].pAlarm := pAlarm;
aZoneAlarmMap[nZoneAlarmCount].pOpcActive := pOpcActive;
aZoneAlarmMap[nZoneAlarmCount].pOpcShelved := pOpcShelved;
aZoneAlarmMap[nZoneAlarmCount].nZone := nZone;

AddZoneAlarmMap := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="InitializeAlarmMapping" Id="{8fadc453-1a7a-4053-a3f2-cb87200f0a42}">
      <Declaration><![CDATA[METHOD InitializeAlarmMapping : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nZoneAlarmCount := 0;
nGlobalAlarmCount := 0;

// ========================================================================
// ZONE ALARMS - Map your existing ST_Alarm to zones
// ========================================================================

// R1 Alarms
(*AddZoneAlarmMap(ADR(GVL_Alarms.R1_Sensor_UnknownState), 
