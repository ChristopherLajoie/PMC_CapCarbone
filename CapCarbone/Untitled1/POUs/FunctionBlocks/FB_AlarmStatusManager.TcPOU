                  ADR(Device_1_Client_1.Tag_Providers_default_Security_Status_Door_3_IsShelved));

AddGlobalAlarmMap(ADR(GVL_Alarms.E_Stop_1), 
                  ADR(Device_1_Client_1.Tag_Providers_default_Security_Status_E_Stop_1_IsActive),
                  ADR(Device_1_Client_1.Tag_Providers_default_Security_Status_E_Stop_1_IsShelved));

