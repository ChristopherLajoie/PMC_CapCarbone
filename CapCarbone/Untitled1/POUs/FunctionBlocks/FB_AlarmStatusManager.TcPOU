InitializeAlarmMapping := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessGlobalAlarm" Id="{df3c8dcc-1639-41f3-a80d-3d9bfae36834}">
      <Declaration><![CDATA[METHOD ProcessGlobalAlarm : BOOL
VAR_INPUT
    stAlarmMap : ST_AlarmZoneMap;
END_VAR
VAR
    pAlarm : POINTER TO ST_Alarm;
    bOpcActive : BOOL;
    bOpcShelved : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Check pointers
IF stAlarmMap.pAlarm = 0 OR stAlarmMap.pOpcActive = 0 OR stAlarmMap.pOpcShelved = 0 THEN
    ProcessGlobalAlarm := FALSE;
    RETURN;
END_IF

// Get alarm data
pAlarm := stAlarmMap.pAlarm;
bOpcActive := stAlarmMap.pOpcActive^;    // From Ignition OPC UA
bOpcShelved := stAlarmMap.pOpcShelved^;  // From Ignition OPC UA

// Update the alarm's bActive status from OPC UA
pAlarm^.bActive := bOpcActive;

// Global alarms always block when active (regardless of severity)
IF bOpcActive AND NOT bOpcShelved THEN
    stSystemStatus.bGlobalOkToRun := FALSE;
END_IF

ProcessGlobalAlarm := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessZoneAlarm" Id="{2dfd239b-192b-4991-b143-7c60f3898bff}">
      <Declaration><![CDATA[METHOD ProcessZoneAlarm : BOOL
VAR_INPUT
    stAlarmMap : ST_AlarmZoneMap;
END_VAR
VAR
    pAlarm : POINTER TO ST_Alarm;
    bOpcActive : BOOL;
    bOpcShelved : BOOL;
    nZone : SINT;
    nSeverity : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Check pointers
IF stAlarmMap.pAlarm = 0 OR stAlarmMap.pOpcActive = 0 OR stAlarmMap.pOpcShelved = 0 THEN
    ProcessZoneAlarm := FALSE;
    RETURN;
END_IF

// Get alarm data
pAlarm := stAlarmMap.pAlarm;
bOpcActive := stAlarmMap.pOpcActive^;    // From Ignition OPC UA
bOpcShelved := stAlarmMap.pOpcShelved^;  // From Ignition OPC UA
nZone := stAlarmMap.nZone;
nSeverity := pAlarm^.nSeverity;          // From your ST_Alarm

// Update the alarm's bActive status from OPC UA
pAlarm^.bActive := bOpcActive;

// Process if active and not shelved
IF bOpcActive AND NOT bOpcShelved THEN
    // Update highest severity for this zone
    IF nSeverity > stSystemStatus.aZoneStatus[nZone].nHighestSeverity THEN
        stSystemStatus.aZoneStatus[nZone].nHighestSeverity := nSeverity;
    END_IF
    
    // Apply blocking logic based on severity
    CASE nSeverity OF
        1, 2:  // Info, Warning - No blocking
            // Already updated severity above
            
        3:     // Error - Block unless maintenance mode
            IF NOT bMaintenanceMode THEN
                stSystemStatus.aZoneStatus[nZone].bOkToRun := FALSE;
            END_IF
            
        4:     // Critical - Always block
            stSystemStatus.aZoneStatus[nZone].bOkToRun := FALSE;
    END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_AlarmStatusManager">
