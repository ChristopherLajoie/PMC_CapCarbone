                ADR(Device_1_Client_1.Tag_Providers_default_Security_Status_R2_Stepper_Reset_Failed_IsShelved), 2);

// R3 Alarms
AddZoneAlarmMap(ADR(GVL_Alarms.R3_Compressor_UnknownState), 
