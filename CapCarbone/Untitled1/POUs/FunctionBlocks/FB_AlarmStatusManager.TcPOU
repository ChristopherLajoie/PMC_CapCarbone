                  ADR(Device_1_Client_1.Tag_Providers_default_Security_Status_E_Stop_2_IsActive),
                  ADR(Device_1_Client_1.Tag_Providers_default_Security_Status_E_Stop_2_IsShelved));

AddGlobalAlarmMap(ADR(GVL_Alarms.E_Stop_3), 
