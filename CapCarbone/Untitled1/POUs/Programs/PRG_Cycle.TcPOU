    <Action Name="_astpCatch_Rail1_active" Id="{15e5e688-c41d-4e1b-83a4-4a0418a7668f}">
      <Implementation>
        <ST><![CDATA[Status := F_IssueActuatorCommand(sDevice := 'R1_Chariot', bArg := TRUE);

CASE Status OF
	1: Result := 0;
	
	0: //Continue
	
	-1: bStopCycleMem := FALSE;
		bStartCycleMem := FALSE;
		bHomingDone := FALSE;
		bCycleDone := FALSE;
		Result := 0;
		SFCReset := TRUE;
END_CASE

]]></ST>
      </Implementation>
