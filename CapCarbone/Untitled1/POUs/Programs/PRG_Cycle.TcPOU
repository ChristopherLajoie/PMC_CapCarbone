    <Action Name="stpHoming_Rail1_active" Id="{56d49874-ad0c-400a-932d-c09aa003556e}">
      <Implementation>
        <ST><![CDATA[Status := F_IssueActuatorCommand(sDevice := 'R1_Motor', bArg := TRUE);

CASE Status OF
	1: Result := 0;
	
	0: //Continue
	
	-1: bStopCycleMem := FALSE;
		bStartCycleMem := FALSE;
		bHomingDone := FALSE;
		bCycleDone := FALSE;
		Result := 0;
		SFCReset := TRUE;
END_CASE

]]></ST>
      </Implementation>
