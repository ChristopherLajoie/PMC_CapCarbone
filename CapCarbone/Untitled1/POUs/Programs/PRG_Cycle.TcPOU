    <Action Name="stpInit_active" Id="{10aa273c-50f4-48b2-827b-3d0220d77be7}">
      <Implementation>
        <ST><![CDATA[SFCReset := FALSE;

(* Read Inputs *)
RTrigStart(CLK := StartCycle OR StartCycle_HMI);
RTrigStop (CLK := StopCycle OR StopCycle_HMI);

IF RTrigStart.Q THEN
    bStartCycleMem := TRUE;   
    StartCycle_HMI := FALSE; 
END_IF

IF RTrigStop.Q THEN
    bStopCycleMem  := TRUE;
    StopCycle_HMI := FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="stpInit_exit" Id="{dcce3caa-9028-4c2f-8708-fd9c7506d3f5}">
      <Implementation>
        <ST><![CDATA[bCycleDone := FALSE;
Result := 0;]]></ST>
      </Implementation>
    </Action>
