    <Action Name="stpInit_active" Id="{10aa273c-50f4-48b2-827b-3d0220d77be7}">
      <Implementation>
        <ST><![CDATA[(* Read Inputs *)
RTrigStart(CLK := StartCycle OR StartCycle_HMI);
RTrigStop (CLK := StopCycle OR StopCycle_HMI);

IF RTrigStart.Q THEN
    bStartCycleMem := TRUE;
    bStopCycleMem  := FALSE;
    
    StartCycle_HMI := FALSE; 
END_IF

IF RTrigStop.Q THEN
    bStopCycleMem  := TRUE;
    bStartCycleMem := FALSE;

    StopCycle_HMI := FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
