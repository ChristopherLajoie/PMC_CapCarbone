    <Action Name="_astpHoming_Tri2_active" Id="{c04d3f22-a0e4-4630-b19b-b107fd2fd0d1}">
      <Implementation>
        <ST><![CDATA[IF bStopCycleMem THEN
	sRequestedActuator := 'none';
	CancelMove := TRUE;
ELSIF NOT bStopCycleMem THEN
	Status := F_IssueActuatorCommand(sDevice := 'R2_Chariot', bArg := FALSE);
END_IF

IF Status = 1 THEN
	Result := 0;
END_IF
]]></ST>
      </Implementation>
    </Action>
