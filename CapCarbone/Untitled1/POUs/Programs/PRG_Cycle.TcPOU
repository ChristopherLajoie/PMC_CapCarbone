    <Action Name="stpDrop_Rail1_active" Id="{4a9d4d90-45fb-4d7d-aad0-afa0f297d2d4}">
      <Implementation>
        <ST><![CDATA[Status := F_IssueActuatorCommand(sDevice := 'R1_Chariot', bArg := FALSE);
 
CASE Status OF
	1: Result := 0;
	
	0: //Continue
	
	-1: bStopCycleMem := FALSE;
		bStartCycleMem := FALSE;
		bHomingDone := FALSE;
		bCycleDone := FALSE;
		Result := 0;
		SFCReset := TRUE;
END_CASE









]]></ST>
      </Implementation>
