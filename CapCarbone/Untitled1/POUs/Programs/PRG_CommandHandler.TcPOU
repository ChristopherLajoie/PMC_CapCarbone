<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="PRG_CommandHandler" Id="{b534ce1c-328a-4a1f-bd2e-b4f58fd46cee}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_CommandHandler
VAR
	bisValidCmd : BOOL;
	bCancelCmd : BOOL;
	bHome : BOOL;
	bisLinearActuator : BOOL;
	LinearActuator : POINTER TO FB_LinearActuator;
	LinearTable : POINTER TO FB_StepperMotor;
	LinearActuatorCmd : POINTER TO ST_LinearActuatorCommand;
	LinearTableCmd : POINTER TO ST_StepperMotorCommand;
	nX : SINT;
	sY : STRING;
	sZ : STRING;
	i: INT;
	bisLinearTableHomeCmd: BOOL;
	bisLinearTableMoveCmd: BOOL;
	bisResetCmd: BOOL;
	CurrentPosition : LREAL;
	Result: INT := 0;
	
	sActiveCommand : STRING := 'none';          // Currently executing command
    bOperationInProgress : BOOL := FALSE;       // Operation state tracking
    bCancelInProgress : BOOL := FALSE;          // Cancel operation active
    tmrCancelTimeout : TON;                     // Cancel timeout timer
    tCancelTimeout : TIME := T#5S;              // Cancel timeout duration
    nCancelResult : INT := 0;                   // Cancel operation result
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
// 1. CANCEL LOGIC - Check cancel request first (highest priority)
// ============================================================================
IF CancelMove AND bOperationInProgress AND NOT bCancelInProgress THEN
    bCancelInProgress := TRUE;
    tmrCancelTimeout(IN := FALSE); // Reset timer
END_IF

// Process active cancel operation
IF bCancelInProgress THEN
    ProcessCancelOperation();
    RETURN; // Skip normal processing during cancel
END_IF

// ============================================================================
// 2. NEW COMMAND LOGIC - Start new command if idle
// ============================================================================
IF NOT bOperationInProgress AND sRequestedActuator <> 'none' THEN
    // Validate and lock onto the new command
    bisValidCmd := F_ValidateCommand(sInput := sRequestedActuator, nX => nX, sY => sY, sZ => sZ);
    
    IF NOT bisValidCmd THEN 
        sRequestedActuator := 'none'; // Clear invalid command
        RETURN; 
    END_IF
    
    // Lock onto this command
    sActiveCommand := sRequestedActuator;
    bOperationInProgress := TRUE;
    
    // Parse the locked command (ignore any future changes to sRequestedActuator)
    LinearActuator := F_GetLinearCommandValue(nX, sY);
    LinearActuatorCmd := F_GetLinearCommandMember(nX, sY);
    LinearTable := F_GetStepperCommandValue(nX, sY);
    LinearTableCmd := F_GetStepperCommandMember(nX, sY);
    
    bisLinearActuator := 
        sY = 'Chariot' OR
        sY = 'Compressor' OR
        sY = 'Sensor' OR
        sY = 'HeatExCoupola' OR
        sY = 'RegenCoupola';
    
    bisLinearTableHomeCmd := sY = 'Home' AND LinearTableCmd^.Homing;
    bisLinearTableMoveCmd := sY = 'Motor';
    bisResetCmd := sZ = 'Reset';
END_IF

// ============================================================================
// 3. ACTIVE COMMAND PROCESSING - Continue with locked command
// ============================================================================
IF bOperationInProgress AND NOT bCancelInProgress THEN
	
    IF bisLinearActuator THEN
        ProcessLinearActuator();
    ELSIF bisLinearTableHomeCmd THEN
        ProcessLinearTable(bHome := TRUE);
    ELSIF bisLinearTableMoveCmd THEN
        ProcessLinearTable(bHome := FALSE);
    END_IF
END_IF]]></ST>
    </Implementation>
    <Method Name="ProcessCancelOperation" Id="{ac957e77-13a6-4f5c-8c3f-8b6fbdb8d91f}">
      <Declaration><![CDATA[
METHOD ProcessCancelOperation
VAR
    bCancelComplete : BOOL := FALSE;
    bTimeoutExpired : BOOL := FALSE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Start cancel timeout timer
tmrCancelTimeout(IN := TRUE, PT := tCancelTimeout);
bTimeoutExpired := tmrCancelTimeout.Q;

IF bisLinearActuator THEN
    // Linear Actuator Cancel - Should complete immediately
    nCancelResult := LinearActuator^.Cancel();
    
    IF nCancelResult = 1 THEN
        // Cancel successful
        LinearActuatorCmd^.Status := -2; // Cancelled status
        bCancelComplete := TRUE;
    ELSIF nCancelResult = -1 THEN
        // Cancel failed - but still complete the cancel operation
        LinearActuatorCmd^.Status := -1; // Error status
        bCancelComplete := TRUE;
    END_IF
    
ELSIF bisLinearTableHomeCmd OR bisLinearTableMoveCmd THEN
    // Stepper Motor Cancel - Use Stop method
    nCancelResult := LinearTable^.Stop(TRUE);
    
    IF nCancelResult = 1 THEN
		
        // Stop successful
        LinearTable^.GetPosition(fCurrentPosition => CurrentPosition);
        LinearTableCmd^.Position := CurrentPosition;
        
        IF bisLinearTableHomeCmd THEN
            LinearTableCmd^.Homed := FALSE;
            LinearTableCmd^.Homing := FALSE;
        END_IF
        
        bCancelComplete := TRUE;
        
    ELSIF nCancelResult = -1 OR bTimeoutExpired THEN
        // Stop failed or timed out
        IF bisLinearTableHomeCmd THEN
            LinearTableCmd^.Homed := FALSE;
            LinearTableCmd^.Homing := FALSE;
        ELSE
            LinearTableCmd^.Position := -1; // Error position
        END_IF
        
        bCancelComplete := TRUE;
        
        // Log timeout alarm if needed
        IF bTimeoutExpired THEN
            // Could trigger a specific cancel timeout alarm here
        END_IF
    END_IF
END_IF

// Complete cancel operation
IF bCancelComplete THEN
    // Clean up state
    sActiveCommand := 'none';
    sRequestedActuator := 'none';  // Clear like normal completion
    bOperationInProgress := FALSE;
    bCancelInProgress := FALSE;
    CancelMove := FALSE;           // Reset cancel trigger
    tmrCancelTimeout(IN := FALSE); // Stop timeout timer
    nCancelResult := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessLinearActuator" Id="{fa11d454-59c0-4fad-b564-0953d0ce78c6}">
      <Declaration><![CDATA[METHOD ProcessLinearActuator
VAR
	bisExtendCmd : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bisExtendCmd := LinearActuatorCmd^.Command;

// Check for reset command
IF bisResetCmd THEN
    LinearActuator^.Reset(State => Result);
    sActiveCommand := 'none';
    sRequestedActuator := 'none';
    bOperationInProgress := FALSE;
    RETURN;
END_IF

// Execute movement command
IF bisExtendCmd THEN
    Result := LinearActuator^.Extend();
ELSE
    Result := LinearActuator^.Home();
END_IF

// Handle results
CASE Result OF
    1: // Success
        sActiveCommand := 'none';
        sRequestedActuator := 'none';
        bOperationInProgress := FALSE;
        
        IF bisExtendCmd THEN
            LinearActuatorCmd^.Status := 1;
        ELSE
            LinearActuatorCmd^.Status := 0;
        END_IF
    
    0: // Continue
        // Operation in progress, continue
        
    -1: // Error
        sActiveCommand := 'none';
        sRequestedActuator := 'none';
        bOperationInProgress := FALSE;
        LinearActuatorCmd^.Status := -1;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessLinearTable" Id="{b89bcaac-8269-4091-97df-2a76137525f9}">
      <Declaration><![CDATA[METHOD ProcessLinearTable
VAR_INPUT
	bHome : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[LinearTable^.GetPosition(fCurrentPosition => CurrentPosition);

// Check for reset command
IF bisResetCmd THEN
    Result := LinearTable^.Reset(TRUE);
    
    CASE Result OF
        1: // Reset success
            sActiveCommand := 'none';
            sRequestedActuator := 'none';
            bOperationInProgress := FALSE;
            LinearTableCmd^.Position := CurrentPosition;
            RETURN;
            
        0: // Reset in progress
            // Continue
            
        -1: // Reset failed
            sActiveCommand := 'none';
            sRequestedActuator := 'none';
            bOperationInProgress := FALSE;
            LinearTableCmd^.Position := -1;
            RETURN;
    END_CASE
END_IF

// Execute movement command
IF bHome THEN
    Result := LinearTable^.Home(TRUE);
ELSE 
    Result := LinearTable^.MoveToPosition(fPosition := LinearTableCmd^.Command);
    LinearTableCmd^.Position := CurrentPosition;
END_IF

// Handle results
CASE Result OF
    1: // Success
        sActiveCommand := 'none';
        sRequestedActuator := 'none';
        bOperationInProgress := FALSE;
        
        IF bHome THEN    
            LinearTableCmd^.Homed := TRUE;
            LinearTableCmd^.Homing := FALSE;
        END_IF
    
    0: // Continue
        // Operation in progress, continue
    
    -1: // Error
        sActiveCommand := 'none';
        sRequestedActuator := 'none';
        bOperationInProgress := FALSE;
        
        IF bHome THEN    
            LinearTableCmd^.Homed := FALSE;
            LinearTableCmd^.Homing := FALSE;
        ELSE
            LinearTableCmd^.Position := -1;
        END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="PRG_CommandHandler">
